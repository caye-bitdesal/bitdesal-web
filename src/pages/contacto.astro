---
import ContactAlternativeLink from '../components/ContactAlternativeLink.astro';
import Layout from '../layouts/Layout.astro';
import {
	BOOKING_URL,
	CONTACT_EMAIL,
	CONTACT_FORM_ENDPOINT,
	CONTACT_PHONE_HREF,
	CONTACT_WHATSAPP_DISPLAY,
	WHATSAPP_URL,
} from '../data/siteConstants';
import { legalPath } from '../i18n/localizedRoutes';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);
const successTitle = t('contact.successTitle');
const successMsg = t('contact.success');
const errorMsg = t('contact.error');
const privacyHref = legalPath('privacy', lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const captchaErrorMsg = t('contact.captchaError');

const tipo = Astro.url.searchParams.get('tipo');
const defaultTopic = tipo === 'software' || tipo === 'consultoria' ? 'software' : 'ia';
---

<Layout seo="contact">
	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
			<h1 class="text-3xl md:text-4xl mb-4">{t('contact.title')}</h1>
			<p class="text-lg text-foreground/80 mb-10">{t('contact.lead')}</p>

			<div id="contact-form-panel">
				<form id="contact-form" class="space-y-5" action={CONTACT_FORM_ENDPOINT} method="POST">
					<div>
						<label for="name" class="block text-sm font-medium mb-1">{t('contact.name')}</label>
						<input id="name" name="name" required class="w-full rounded-lg border border-border px-4 py-2.5 bg-input-background" />
					</div>
					<div>
						<label for="company" class="block text-sm font-medium mb-1">{t('contact.company')}</label>
						<input id="company" name="company" class="w-full rounded-lg border border-border px-4 py-2.5 bg-input-background" />
					</div>
					<div>
						<label for="topic" class="block text-sm font-medium mb-1">{t('contact.topicLabel')}</label>
						<select id="topic" name="topic" required class="w-full rounded-lg border border-border px-4 py-2.5 bg-input-background">
							<option value="ia" selected={defaultTopic === 'ia'}>{t('contact.topicIa')}</option>
							<option value="software" selected={defaultTopic === 'software'}>{t('contact.topicSoftware')}</option>
							<option value="other">{t('contact.topicOther')}</option>
						</select>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium mb-1">{t('contact.message')}</label>
						<textarea id="message" name="message" required rows="5" class="w-full rounded-lg border border-border px-4 py-2.5 bg-input-background"></textarea>
					</div>
					<div>
						<label for="contact" class="block text-sm font-medium mb-1">{t('contact.emailOrPhone')}</label>
						<input id="contact" name="contact" required class="w-full rounded-lg border border-border px-4 py-2.5 bg-input-background" />
					</div>
					<input
						type="text"
						name="_gotcha"
						class="absolute -left-[5000px] w-px h-px overflow-hidden"
						tabindex="-1"
						autocomplete="off"
						aria-hidden="true"
					/>
					<div class="flex items-start gap-3">
						<input
							id="privacy-consent"
							type="checkbox"
							required
							class="mt-1 h-4 w-4 shrink-0 rounded border-border"
						/>
						<label for="privacy-consent" class="text-sm text-foreground/80 leading-relaxed">
							{t('contact.consentBefore')}
							<a href={privacyHref} class="text-primary underline">{t('contact.privacyPolicy')}</a>
							{t('contact.consentAfter')}
						</label>
					</div>
					{
						turnstileSiteKey ? (
							<div
								id="contact-turnstile"
								class="cf-turnstile min-h-[65px]"
								data-sitekey={turnstileSiteKey}
								data-theme="light"
							/>
						) : null
					}
					<button
						id="contact-submit"
						type="submit"
						class="inline-flex items-center justify-center bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
					>
						{t('contact.submit')}
					</button>
					<p class="text-xs text-foreground/55 leading-relaxed">{t('contact.dataNotice')}</p>
					<p id="form-status" class="text-sm hidden" role="alert"></p>
				</form>
			</div>

			<div
				id="contact-success-panel"
				class="hidden rounded-2xl border border-border bg-secondary/40 px-6 py-10 sm:px-10 sm:py-12 text-center"
				role="dialog"
				aria-modal="true"
				aria-labelledby="contact-success-title"
				tabindex="-1"
			>
				<img
					src="/contact-icons/contact-sent.png"
					width="100"
					height="100"
					alt=""
					class="mx-auto mb-6 h-[100px] w-[100px]"
					loading="lazy"
					decoding="async"
				/>
				<h2 id="contact-success-title" class="text-2xl md:text-3xl mb-3">{successTitle}</h2>
				<p class="text-foreground/80 text-lg max-w-md mx-auto">{successMsg}</p>
			</div>

			<div class="mt-12 pt-10 border-t border-border">
				<p class="text-base font-medium text-foreground/80 mb-5">{t('contact.alternatives')}</p>
				<ul class="space-y-3">
					<li>
						<ContactAlternativeLink href={BOOKING_URL} icon="calendar" label={t('contact.book')} />
					</li>
					<li>
						<ContactAlternativeLink
							href={CONTACT_PHONE_HREF}
							icon="phone"
							label={CONTACT_WHATSAPP_DISPLAY}
						/>
					</li>
					<li>
						<ContactAlternativeLink
							href={WHATSAPP_URL}
							icon="whatsapp"
							label={t('contact.whatsapp')}
							external
						/>
					</li>
					<li>
						<ContactAlternativeLink href={`mailto:${CONTACT_EMAIL}`} icon="email" label={CONTACT_EMAIL} />
					</li>
				</ul>
				<p class="text-sm text-foreground/60 mt-8">{t('contact.location')}</p>
			</div>
		</div>
	</section>
	{turnstileSiteKey ? (
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
	) : null}
</Layout>

<script define:vars={{ endpoint: CONTACT_FORM_ENDPOINT, errorMsg, captchaErrorMsg, turnstileSiteKey }}>
	const form = document.getElementById('contact-form');
	const formPanel = document.getElementById('contact-form-panel');
	const successPanel = document.getElementById('contact-success-panel');
	const status = document.getElementById('form-status');
	const submitBtn = document.getElementById('contact-submit');
	const turnstileEl = document.getElementById('contact-turnstile');

	const resetTurnstile = () => {
		if (!turnstileSiteKey || !turnstileEl || !window.turnstile) return;
		window.turnstile.reset(turnstileEl);
	};

	form?.addEventListener('submit', async (e) => {
		if (!endpoint || endpoint.startsWith('#TODO')) {
			e.preventDefault();
			if (status) {
				status.textContent = errorMsg;
				status.classList.remove('hidden');
				status.classList.add('text-destructive');
			}
			return;
		}

		e.preventDefault();

		if (turnstileSiteKey) {
			const token = form.querySelector('[name="cf-turnstile-response"]')?.value?.trim();
			if (!token) {
				if (status) {
					status.textContent = captchaErrorMsg;
					status.classList.remove('hidden');
					status.classList.add('text-destructive');
				}
				return;
			}
		}

		submitBtn?.setAttribute('disabled', 'disabled');
		if (status) status.classList.add('hidden');

		const data = new FormData(form);
		try {
			const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
			const payload = await res.json().catch(() => null);
			if (!res.ok || payload?.ok === false) throw new Error('fail');
			formPanel?.classList.add('hidden');
			successPanel?.classList.remove('hidden');
			successPanel?.focus();
		} catch {
			if (status) {
				status.textContent = errorMsg;
				status.classList.remove('hidden');
				status.classList.add('text-destructive');
			}
			submitBtn?.removeAttribute('disabled');
			resetTurnstile();
		}
	});
</script>
