---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../data/siteNav';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);
---

<Layout seo="projects">
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6">{t('projects.hero.title')}</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto">{t('projects.hero.subtitle')}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<a
				href={sitePath('/projects/kivra', lang)}
				class="group block border border-border rounded-xl p-8 md:p-10 hover:border-primary transition-colors shadow-sm hover:shadow-md"
			>
				<div class="flex items-start gap-6 mb-8">
					<img src="/kivra-app-icon.png" alt="Icono de Kivra Finland" width="96" height="96" class="w-24 h-24 rounded-2xl shadow-lg shrink-0" loading="lazy" />
					<div class="min-w-0 pt-1">
						<h2 class="text-3xl md:text-4xl mb-2 group-hover:text-primary transition-colors">{t('projects.kivra.name')}</h2>
						<p class="text-foreground/60">{t('projects.kivra.tag')} · {t('projects.kivra.updated')}</p>
					</div>
				</div>
				<p class="text-lg text-foreground/80 leading-relaxed mb-8">{t('projects.kivra.description')}</p>
				<span class="inline-flex items-center gap-2 text-primary text-lg group-hover:gap-3 transition-all">
					{t('projects.viewProject')}
					<span aria-hidden="true">→</span>
				</span>
			</a>
		</div>
	</section>

	<CtaSection />
</Layout>
