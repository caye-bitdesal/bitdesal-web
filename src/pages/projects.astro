---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="projects.hero.title">Projects</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="projects.hero.subtitle">
				A selection of Android and software work delivered by Bitdesal
			</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<a
				href="/projects/kivra"
				class="group block border border-border rounded-xl p-8 md:p-10 hover:border-primary transition-colors shadow-sm hover:shadow-md"
			>
				<div class="flex items-start gap-6 mb-8">
					<img
						src="/kivra-app-icon.png"
						alt="Kivra Finland"
						width="96"
						height="96"
						class="w-24 h-24 rounded-2xl shadow-lg shrink-0"
						loading="lazy"
						decoding="async"
					/>
					<div class="min-w-0 pt-1">
						<h2
							class="text-3xl md:text-4xl mb-2 group-hover:text-primary transition-colors"
							data-i18n-key="projects.kivra.name"
						>
							Kivra Finland
						</h2>
						<p class="text-foreground/60">
							<span data-i18n-key="projects.kivra.tag">Android · Productivity</span>
							<span aria-hidden="true"> · </span>
							<span data-i18n-key="projects.kivra.updated">2026</span>
						</p>
					</div>
				</div>
				<p class="text-lg text-foreground/80 leading-relaxed mb-8" data-i18n-key="projects.kivra.description">
					Digital mail app used by hundreds of thousands in Finland to receive invoices, letters, tickets and
					official documents securely.
				</p>
				<span class="inline-flex items-center gap-2 text-primary text-lg group-hover:gap-3 transition-all">
					<span data-i18n-key="projects.viewProject">View project</span>
					<span aria-hidden="true">→</span>
				</span>
			</a>

			<a
				href="/projects/yossa"
				class="group block border border-border rounded-xl p-8 md:p-10 hover:border-primary transition-colors shadow-sm hover:shadow-md"
			>
				<div class="flex items-start gap-6 mb-8">
					<img
						src="/projects/yossa/yossa-app-icon.png"
						alt="Yössä"
						width="96"
						height="96"
						class="w-24 h-24 rounded-2xl shadow-lg shrink-0"
						loading="lazy"
						decoding="async"
					/>
					<div class="min-w-0 pt-1">
						<h2
							class="text-3xl md:text-4xl mb-2 group-hover:text-primary transition-colors"
							data-i18n-key="projects.yossa.name"
						>
							Yössä
						</h2>
						<p class="text-foreground/60">
							<span data-i18n-key="projects.yossa.tag">Android · Nightlife</span>
							<span aria-hidden="true"> · </span>
							<span data-i18n-key="projects.yossa.updated">2015</span>
						</p>
					</div>
				</div>
				<p class="text-lg text-foreground/80 leading-relaxed mb-8" data-i18n-key="projects.yossa.description">
					Nightlife app to find bars, events and drink offers around you — offers unlock when you are close enough to
					redeem them.
				</p>
				<span class="inline-flex items-center gap-2 text-primary text-lg group-hover:gap-3 transition-all">
					<span data-i18n-key="projects.viewProject">View project</span>
					<span aria-hidden="true">→</span>
				</span>
			</a>
		</div>
	</section>

	<CtaSection />
</Layout>
