---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="methodology.hero.title">Our Methodology</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="methodology.hero.subtitle">
				Internationally proven processes that guarantee quality, transparency and results
			</p>
		</div>
	</section>

	<section class="py-12 md:py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] xl:grid-cols-[1fr_300px] gap-10 lg:gap-12 items-start">
				<div class="space-y-10 min-w-0">
					<div>
						<h2 class="text-2xl md:text-3xl mb-3" data-i18n-key="methodology.specDriven.title">Spec-Driven Development</h2>
						<p class="text-base text-foreground/80 mb-4" data-i18n-key="methodology.specDriven.description">
							We start every project with clear, detailed specifications.
						</p>
						<div class="space-y-3">
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.specDriven.requirements.title">
										Crystal Clear Requirements
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.specDriven.requirements.description">
										We document every feature and acceptance criteria.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.specDriven.noSurprises.title">
										No Surprises
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.specDriven.noSurprises.description">
										You know exactly what you'll receive.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.specDriven.testing.title">
										Foundation for Testing
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.specDriven.testing.description">
										Specs become automated test cases.
									</p>
								</div>
							</div>
						</div>
					</div>

					<div>
						<h2 class="text-2xl md:text-3xl mb-3" data-i18n-key="methodology.quality.title">Technical Quality</h2>
						<p class="text-base text-foreground/80 mb-4" data-i18n-key="methodology.quality.description">
							We make no compromises on quality.
						</p>
						<div class="space-y-3">
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.quality.codeReview.title">
										Mandatory Code Review
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.quality.codeReview.description">
										All code goes through thorough review.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.quality.comprehensiveTesting.title">
										Comprehensive Testing
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.quality.comprehensiveTesting.description">
										Unit, integration and UI tests.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.quality.cicd.title">
										Automated CI/CD
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.quality.cicd.description">
										Automatic pipeline on every commit.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.quality.cleanCode.title">
										Clean Code
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.quality.cleanCode.description">
										SOLID principles and community conventions.
									</p>
								</div>
							</div>
						</div>
					</div>

					<div>
						<h2 class="text-2xl md:text-3xl mb-3" data-i18n-key="methodology.remoteFirst.title">Remote-First</h2>
						<p class="text-base text-foreground/80 mb-4" data-i18n-key="methodology.remoteFirst.description">
							We work fully remotely with asynchronous methodologies.
						</p>
						<div class="space-y-3">
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.remoteFirst.async.title">
										Asynchronous Communication
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.remoteFirst.async.description">
										Comprehensive documentation and regular updates.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.remoteFirst.flexibility.title">
										Time Flexibility
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.remoteFirst.flexibility.description">
										We adapt our schedules to overlap with your timezone.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
								>
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h3 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.remoteFirst.tools.title">
										Modern Tools
									</h3>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.remoteFirst.tools.description">
										Slack, Notion, GitHub, Linear and more.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<aside class="w-full max-w-[260px] mx-auto lg:mx-0 lg:max-w-none shrink-0">
					<button
						type="button"
						id="sdd-open"
						class="w-full bg-secondary rounded-lg p-3 cursor-zoom-in transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
						aria-label="View diagram enlarged"
					>
						<img
							data-sdd-lang="en"
							src="/bitdesal_sdd_en.svg"
							alt="Spec-Driven Development diagram (English)"
							class="w-full h-auto rounded-md pointer-events-none"
							width="680"
							height="900"
							loading="lazy"
							decoding="async"
						/>
						<img
							data-sdd-lang="es"
							src="/bitdesal_sdd_es.svg"
							alt="Diagrama de Spec-Driven Development (Español)"
							class="w-full h-auto rounded-md hidden pointer-events-none"
							width="680"
							height="900"
							loading="lazy"
							decoding="async"
						/>
						<img
							data-sdd-lang="fi"
							src="/bitdesal_sdd_fi.svg"
							alt="Spec-Driven Development -kaavio (Suomi)"
							class="w-full h-auto rounded-md hidden pointer-events-none"
							width="680"
							height="900"
							loading="lazy"
							decoding="async"
						/>
					</button>
				</aside>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="methodology.process.title">Our Process</h2>
				<p class="text-lg text-foreground/80 max-w-2xl mx-auto" data-i18n-key="methodology.process.subtitle">
					A proven workflow that takes projects from idea to production predictably
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>1</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.discovery.title">Discovery</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.discovery.description">
						We understand your goals, requirements and constraints.
					</p>
				</div>

				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>2</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.specification.title">Specification</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.specification.description">
						We create detailed specs and acceptance criteria.
					</p>
				</div>

				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>3</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.development.title">Development</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.development.description">
						Iterative development with regular demos.
					</p>
				</div>

				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>4</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.delivery.title">Delivery</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.delivery.description">
						Delivery with complete documentation and handoff.
					</p>
				</div>
			</div>
		</div>
	</section>

	<CtaSection />

	<div
		id="sdd-modal"
		class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-8"
		role="dialog"
		aria-modal="true"
		aria-labelledby="sdd-modal-title"
	>
		<div class="absolute inset-0 bg-black/70" data-sdd-close></div>
		<div class="relative z-10 w-full max-w-3xl max-h-[90vh] flex flex-col">
			<p id="sdd-modal-title" class="sr-only">Spec-Driven Development diagram</p>
			<button
				type="button"
				data-sdd-close
				class="absolute -top-2 -right-2 sm:top-0 sm:right-0 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white text-foreground shadow-lg hover:bg-white/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
				aria-label="Close"
			>
				<span class="text-2xl leading-none" aria-hidden="true">×</span>
			</button>
			<div class="overflow-auto rounded-lg bg-secondary p-4 sm:p-6">
				<img id="sdd-modal-img" src="" alt="" class="w-full h-auto" />
			</div>
		</div>
	</div>
</Layout>

<script>
	function getActiveSddImg() {
		return document.querySelector('[data-sdd-lang]:not(.hidden)');
	}

	function applySddLang(lang) {
		document.querySelectorAll('[data-sdd-lang]').forEach((img) => {
			const isActive = img.getAttribute('data-sdd-lang') === lang;
			img.classList.toggle('hidden', !isActive);
		});

		const modal = document.getElementById('sdd-modal');
		const modalImg = document.getElementById('sdd-modal-img');
		if (modal && !modal.classList.contains('hidden') && modalImg) {
			const active = getActiveSddImg();
			if (active) {
				modalImg.src = active.src;
				modalImg.alt = active.alt;
			}
		}
	}

	function openSddModal() {
		const modal = document.getElementById('sdd-modal');
		const modalImg = document.getElementById('sdd-modal-img');
		const active = getActiveSddImg();
		if (!modal || !modalImg || !active) return;

		modalImg.src = active.src;
		modalImg.alt = active.alt;
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.style.overflow = 'hidden';
	}

	function closeSddModal() {
		const modal = document.getElementById('sdd-modal');
		if (!modal) return;

		modal.classList.add('hidden');
		modal.classList.remove('flex');
		document.body.style.overflow = '';
	}

	const openBtn = document.getElementById('sdd-open');
	openBtn?.addEventListener('click', openSddModal);

	document.querySelectorAll('[data-sdd-close]').forEach((el) => {
		el.addEventListener('click', closeSddModal);
	});

	document.addEventListener('keydown', (e) => {
		const modal = document.getElementById('sdd-modal');
		if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
			closeSddModal();
		}
	});

	applySddLang(window.bitdesalI18n?.getLanguage?.() || 'en');

	window.addEventListener('bitdesal:language', (e) => {
		const lang = e?.detail?.lang;
		if (lang) applySddLang(lang);
	});
</script>
