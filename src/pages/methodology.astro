---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="methodology.hero.title">Our Methodology</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="methodology.hero.subtitle">
				Internationally proven processes that guarantee quality, transparency and results
			</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-24">
				<div>
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">🌐</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="methodology.remoteFirst.title">Remote-First</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="methodology.remoteFirst.description">
						We work fully remotely with asynchronous methodologies.
					</p>
					<div class="space-y-4">
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.remoteFirst.async.title">Asynchronous Communication</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.remoteFirst.async.description">
									Comprehensive documentation and regular updates.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.remoteFirst.flexibility.title">Time Flexibility</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.remoteFirst.flexibility.description">
									We adapt our schedules to overlap with your timezone.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.remoteFirst.tools.title">Modern Tools</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.remoteFirst.tools.description">
									Slack, Notion, GitHub, Linear and more.
								</p>
							</div>
						</div>
					</div>
				</div>
				<div class="bg-secondary rounded-lg p-8">
					<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
						<span class="text-white/20 text-6xl font-semibold">🌐</span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-24">
				<div class="order-2 lg:order-1">
					<div class="bg-secondary rounded-lg p-8">
						<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
							<span class="text-white/20 text-6xl font-semibold">▦</span>
						</div>
					</div>
				</div>
				<div class="order-1 lg:order-2">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">▦</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="methodology.specDriven.title">Spec-Driven Development</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="methodology.specDriven.description">
						We start every project with clear, detailed specifications.
					</p>
					<div class="space-y-4">
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.specDriven.requirements.title">Crystal Clear Requirements</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.specDriven.requirements.description">
									We document every feature and acceptance criteria.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.specDriven.noSurprises.title">No Surprises</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.specDriven.noSurprises.description">
									You know exactly what you'll receive.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.specDriven.testing.title">Foundation for Testing</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.specDriven.testing.description">
									Specs become automated test cases.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div>
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">✓</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="methodology.quality.title">Technical Quality</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="methodology.quality.description">
						We make no compromises on quality.
					</p>
					<div class="space-y-4">
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.quality.codeReview.title">Mandatory Code Review</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.quality.codeReview.description">
									All code goes through thorough review.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.quality.comprehensiveTesting.title">Comprehensive Testing</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.quality.comprehensiveTesting.description">
									Unit, integration and UI tests.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.quality.cicd.title">Automated CI/CD</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.quality.cicd.description">
									Automatic pipeline on every commit.
								</p>
							</div>
						</div>
						<div class="flex items-start gap-3">
							<div class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-white text-sm">✓</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="methodology.quality.cleanCode.title">Clean Code</h3>
								<p class="text-foreground/70" data-i18n-key="methodology.quality.cleanCode.description">
									SOLID principles and community conventions.
								</p>
							</div>
						</div>
					</div>
				</div>
				<div class="bg-secondary rounded-lg p-8">
					<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
						<span class="text-white/20 text-6xl font-semibold">✓</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="methodology.process.title">Our Process</h2>
				<p class="text-lg text-foreground/80 max-w-2xl mx-auto" data-i18n-key="methodology.process.subtitle">
					A proven workflow that takes projects from idea to production predictably
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>1</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.discovery.title">Discovery</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.discovery.description">
						We understand your goals, requirements and constraints.
					</p>
				</div>

				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>2</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.specification.title">Specification</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.specification.description">
						We create detailed specs and acceptance criteria.
					</p>
				</div>

				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>3</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.development.title">Development</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.development.description">
						Iterative development with regular demos.
					</p>
				</div>

				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>4</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.delivery.title">Delivery</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.delivery.description">
						Delivery with complete documentation and handoff.
					</p>
				</div>
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>

