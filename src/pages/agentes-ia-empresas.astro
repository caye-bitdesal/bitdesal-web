---
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Layout from '../layouts/Layout.astro';
import { agentsPage as copy } from '../i18n/content/agents-page.es';
import { BOOKING_URL, SITE_ORIGIN } from '../data/siteConstants';
import { ORG_ID } from '../data/siteJsonLd';

const canonical = new URL('/agentes-ia-empresas/', SITE_ORIGIN).href;

const serviceJsonLd = {
	'@type': 'Service',
	'@id': `${canonical}#service`,
	name: 'Agentes de IA para empresas',
	serviceType: 'Agentes de IA para empresas',
	description: copy.hero.lead,
	provider: { '@id': ORG_ID },
	areaServed: { '@type': 'Country', name: 'España' },
	url: canonical,
};

const faqItems = [
	{ question: copy.faq.diff.q, answer: copy.faq.diff.a },
	{ question: copy.faq.alone.q, answer: copy.faq.alone.a },
	{ question: copy.faq.whatsapp.q, answer: copy.faq.whatsapp.a },
	{ question: copy.faq.replace.q, answer: copy.faq.replace.a },
];

const cases = [copy.cases.voice, copy.cases.whatsapp, copy.cases.delivery, copy.cases.follow];
const rows = [copy.compare.rows.auto, copy.compare.rows.chat, copy.compare.rows.agent];
---

<Layout seo="aiAgents" alternates={['es']} breadcrumbLabel={copy.hero.h1} jsonLd={[serviceJsonLd]}>
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h1 class="text-4xl md:text-5xl mb-6">{copy.hero.h1}</h1>
			<div class="space-y-4 text-lg text-white/90 leading-relaxed">
				<p>{copy.hero.lead}</p>
				<p>{copy.hero.p2}</p>
			</div>
			<a
				href={BOOKING_URL}
				class="inline-flex items-center gap-2 mt-8 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors"
			>
				Agenda 30 min gratis
			</a>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-lg text-foreground/80 leading-relaxed">
			<h2 class="text-3xl md:text-4xl text-foreground">{copy.what.title}</h2>
			<p>{copy.what.p1}</p>
			<p>{copy.what.p2}</p>
			<p>{copy.what.p3}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-4">{copy.compare.title}</h2>
			<p class="text-lg text-foreground/80 leading-relaxed mb-8">{copy.compare.lead}</p>
			<div class="space-y-4 md:hidden">
				{
					rows.map((row) => (
						<article class="rounded-xl border border-border bg-card p-5">
							<h3 class="text-lg mb-2">{row.type}</h3>
							<p class="text-foreground/80 mb-2">
								<span class="font-medium text-foreground">{copy.compare.headers.does}. </span>
								{row.does}
							</p>
							<p class="text-foreground/80">
								<span class="font-medium text-foreground">{copy.compare.headers.fits}. </span>
								{row.fits}
							</p>
						</article>
					))
				}
			</div>
			<div class="hidden md:block">
				<table class="w-full text-left text-sm border-collapse bg-card rounded-xl">
					<thead>
						<tr class="border-b border-border">
							<th class="p-4 font-medium w-[18%]" scope="col">{copy.compare.headers.type}</th>
							<th class="p-4 font-medium" scope="col">{copy.compare.headers.does}</th>
							<th class="p-4 font-medium" scope="col">{copy.compare.headers.fits}</th>
						</tr>
					</thead>
					<tbody>
						{
							rows.map((row) => (
								<tr class="border-b border-border align-top">
									<th class="p-4 font-medium" scope="row">{row.type}</th>
									<td class="p-4 text-foreground/80">{row.does}</td>
									<td class="p-4 text-foreground/80">{row.fits}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="text-foreground/80 leading-relaxed mt-6">{copy.compare.after}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-4">{copy.cases.title}</h2>
			<p class="text-lg text-foreground/80 leading-relaxed mb-10">{copy.cases.lead}</p>
			<div class="space-y-8">
				{
					cases.map((item) => (
						<article>
							<h3 class="text-xl mb-3">{item.title}</h3>
							<p class="text-foreground/80 leading-relaxed">{item.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-lg text-foreground/80 leading-relaxed">
			<h2 class="text-3xl md:text-4xl text-foreground">{copy.limits.title}</h2>
			<p>{copy.limits.p1}</p>
			<p>{copy.limits.p2}</p>
			<p>{copy.limits.p3}</p>
			<h2 class="text-3xl md:text-4xl text-foreground pt-4">{copy.data.title}</h2>
			<p>{copy.data.p1}</p>
			<p>
				{copy.data.p2}{' '}
				<a href={copy.data.lawHref} class="text-primary font-medium hover:underline" rel="noopener noreferrer">
					{copy.data.lawLink}
				</a>
			</p>
		</div>
	</section>

	<section class="py-16 md:py-20 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-lg text-foreground/80 leading-relaxed">
			<h2 class="text-3xl md:text-4xl text-foreground">{copy.price.title}</h2>
			<p>{copy.price.p1}</p>
			<p>{copy.price.p2}</p>
			<p>{copy.price.p3}</p>
			<p>
				<a href="/casos-y-precios/#ia" class="text-primary font-medium hover:underline">{copy.price.link}</a>
			</p>
			<h2 class="text-2xl text-foreground pt-4">{copy.related.title}</h2>
			<ul class="space-y-3 text-base">
				<li><a class="text-primary font-medium hover:underline" href="/consultoria-ia/">{copy.related.ia}</a></li>
				<li><a class="text-primary font-medium hover:underline" href="/automatizacion-procesos-ia/">{copy.related.auto}</a></li>
				<li><a class="text-primary font-medium hover:underline" href="/consultoria-ia-alicante-elche/">{copy.related.local}</a></li>
				<li><a class="text-primary font-medium hover:underline" href="/blog/cuanto-cuesta-implementar-ia-empresa/">{copy.related.costGuide}</a></li>
				<li><a class="text-primary font-medium hover:underline" href="/contacto/">{copy.related.contact}</a></li>
			</ul>
		</div>
	</section>

	<FaqSection title={copy.faq.title} items={faqItems} />
	<CtaSection variant="ia" />
</Layout>
