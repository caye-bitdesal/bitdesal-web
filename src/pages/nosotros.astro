---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import { teamMembers } from '../data/teamMembers';
import { useI18n } from '../i18n/useI18n';

const { t } = useI18n(Astro);

const defaultMemberId = teamMembers[0]?.id ?? 'caye';

const roles = [
	{ id: 'bitdesal', items: 2, icon: 'briefcase' },
	{ id: 'kivra', items: 3, icon: 'phone' },
	{ id: 'optiscan', items: 2, icon: 'code' },
	{ id: 'frosmo', items: 2, icon: 'web' },
	{ id: 'sankarimedia', items: 2, icon: 'phone' },
	{ id: 'awimbawe', items: 2, icon: 'phone' },
	{ id: 'sicpa', items: 3, icon: 'code' },
	{ id: 'entropia', items: 1, icon: 'web' },
	{ id: 'comeks', items: 1, icon: 'web' },
] as const;

const roleIcons: Record<(typeof roles)[number]['icon'], string> = {
	briefcase: '<path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M4 12h16"/>',
	phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
	code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
	web: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
};

const skills = ['kotlin', 'compose', 'architecture', 'testing', 'ai', 'mentoring'] as const;
---

<Layout seo="about">
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6">{t('about.pageTitle', 'Nosotros')}</h1>
			<p class="text-sm md:text-base text-white/85 max-w-2xl mx-auto">{t('about.stats.line')}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<article class="space-y-4 text-lg text-foreground/80 leading-relaxed">
				<p>{t('about.company.p1')}</p>
				<p>{t('about.company.p2')}</p>
				<p>{t('about.company.p3')}</p>
				<p>{t('about.company.p4')}</p>
				<p>{t('about.company.p5')}</p>
			</article>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary" id="equipo">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8">{t('about.team.title')}</h2>

			<div class="flex flex-wrap gap-6" role="group" aria-label={t('about.team.title')}>
				{
					teamMembers.map((member) => (
						<article
							class="team-member-card max-w-xl flex-1 min-w-[min(100%,20rem)] rounded-xl p-8 shadow-sm border-2 bg-white flex flex-col sm:flex-row gap-6 text-left cursor-pointer transition-all hover:border-primary/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border-border data-[selected=true]:border-primary data-[selected=true]:shadow-md"
							data-team-member={member.id}
							data-selected={member.id === defaultMemberId ? 'true' : 'false'}
							data-extended-profile={member.showExtendedProfile ? 'true' : 'false'}
							tabindex={member.id === defaultMemberId ? 0 : -1}
							role="button"
							aria-pressed={member.id === defaultMemberId}
						>
							<img
								src={member.portrait}
								alt={member.portraitAlt}
								class="w-32 h-32 rounded-lg object-cover shrink-0 pointer-events-none"
								loading="lazy"
							/>
							<div class="min-w-0">
								<h3 class="text-xl mb-1 pointer-events-none">
									{t(member.nameKey)} · {t(member.titleKey)}
								</h3>
								<p class="text-foreground/75 text-sm mb-4 pointer-events-none">{t(member.bioKey)}</p>
								<div class="flex flex-wrap gap-4 text-sm">
									{
										member.linkedin && (
											<a
												href={member.linkedin}
												target="_blank"
												rel="noopener noreferrer"
												class="text-primary hover:underline relative z-10"
												data-team-link
											>
												{t('about.profiles.linkedin')}
											</a>
										)
									}
									{
										member.github && (
											<a
												href={member.github}
												target="_blank"
												rel="noopener noreferrer"
												class="text-primary hover:underline relative z-10"
												data-team-link
											>
												{t('about.profiles.github')}
											</a>
										)
									}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<div id="team-extended-sections" hidden={!teamMembers.some((m) => m.showExtendedProfile && m.id === defaultMemberId)}>
		<section class="py-16 md:py-24 bg-white" data-extended-for="caye">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl md:text-4xl mb-12">{t('about.journey.title')}</h2>
				<ol class="relative">
					{
						roles.map((role) => (
							<li class="group relative pl-14 pb-12 last:pb-0">
								<span class="absolute left-[15px] top-4 bottom-0 w-0.5 bg-primary/35 group-last:hidden" aria-hidden="true" />
								<span class="absolute left-0 top-0 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white ring-4 ring-secondary" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" set:html={roleIcons[role.icon]} />
								</span>
								<div class="relative rounded-lg p-4 -mx-2">
									<h3 class="text-xl mb-1">{t(`about.journey.${role.id}.role`)}</h3>
									<p class="text-foreground/70 mb-1">
										{t(`about.journey.${role.id}.company`)} · {t(`about.journey.${role.id}.location`)}
									</p>
									<p class="text-sm text-primary font-medium mb-3">{t(`about.journey.${role.id}.dates`)}</p>
									<ul class="list-disc list-outside ml-4 space-y-1.5 text-foreground/70">
										{Array.from({ length: role.items }, (_, i) => (
											<li>{t(`about.journey.${role.id}.item${i + 1}`)}</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="py-16 md:py-24 bg-secondary" data-extended-for="caye">
			<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl md:text-4xl mb-8">{t('about.education.title')}</h2>
				<div>
					<h3 class="text-xl mb-1">{t('about.education.degree')}</h3>
					<p class="text-foreground/70 mb-1">{t('about.education.institution')}</p>
					<p class="text-sm text-primary font-medium">{t('about.education.dates')}</p>
				</div>
			</div>
		</section>

		<section class="py-16 md:py-24 bg-white" data-extended-for="caye">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl md:text-4xl mb-12 text-center">{t('about.skills.title')}</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
					{
						skills.map((skill) => (
							<div class="bg-secondary rounded-lg p-6">
								<h3 class="mb-2">{t(`about.skills.${skill}.title`)}</h3>
								<p class="text-sm text-foreground/70">{t(`about.skills.${skill}.description`)}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</div>

	<CtaSection />
</Layout>

<script define:vars={{ extendedMemberIds: teamMembers.filter((m) => m.showExtendedProfile).map((m) => m.id) }}>
	const cards = document.querySelectorAll('.team-member-card');
	const extendedWrapper = document.getElementById('team-extended-sections');

	function selectMember(memberId) {
		cards.forEach((card) => {
			const isSelected = card.getAttribute('data-team-member') === memberId;
			card.dataset.selected = isSelected ? 'true' : 'false';
			card.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
			card.tabIndex = isSelected ? 0 : -1;
		});

		if (extendedWrapper) {
			extendedWrapper.hidden = !extendedMemberIds.includes(memberId);
		}
	}

	cards.forEach((card) => {
		card.addEventListener('click', (event) => {
			if (event.target.closest('[data-team-link]')) return;
			const memberId = card.getAttribute('data-team-member');
			if (memberId) selectMember(memberId);
		});

		card.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			const memberId = card.getAttribute('data-team-member');
			if (memberId) selectMember(memberId);
		});
	});
</script>
