---
import CtaSection from '../components/CtaSection.astro';
import TeamMemberExtended from '../components/TeamMemberExtended.astro';
import Layout from '../layouts/Layout.astro';
import { teamMembers } from '../data/teamMembers';
import { useI18n } from '../i18n/useI18n';

const { t } = useI18n(Astro);

const defaultMemberId = teamMembers[0]?.id ?? 'caye';
const extendedMemberIds = teamMembers.filter((m) => m.showExtendedProfile).map((m) => m.id);
---

<Layout seo="about">
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6">{t('about.pageTitle', 'Nosotros')}</h1>
			<p class="text-sm md:text-base text-white/85 max-w-2xl mx-auto">{t('about.stats.line')}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<article class="space-y-4 text-lg text-foreground/80 leading-relaxed">
				<p>{t('about.company.p1')}</p>
				<p>{t('about.company.p2')}</p>
				<p>{t('about.company.p3')}</p>
				<p>{t('about.company.p4')}</p>
				<p>{t('about.company.p5')}</p>
			</article>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary" id="equipo">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8">{t('about.team.title')}</h2>

			<div class="flex flex-wrap items-stretch gap-6" role="group" aria-label={t('about.team.title')}>
				{
					teamMembers.map((member) => (
						<article
							class="team-member-card flex-1 min-w-[min(100%,18rem)] max-w-xl h-full rounded-xl p-8 shadow-sm border-2 bg-white flex flex-col sm:flex-row gap-6 text-left cursor-pointer transition-all hover:border-primary/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 border-border data-[selected=true]:border-primary data-[selected=true]:shadow-md"
							data-team-member={member.id}
							data-selected={member.id === defaultMemberId ? 'true' : 'false'}
							data-extended-profile={member.showExtendedProfile ? 'true' : 'false'}
							tabindex={member.id === defaultMemberId ? 0 : -1}
							role="button"
							aria-pressed={member.id === defaultMemberId}
						>
							<img
								src={member.portrait}
								alt={member.portraitAlt}
								class="w-32 h-32 rounded-lg object-cover shrink-0 pointer-events-none bg-secondary"
								loading="lazy"
							/>
							<div class="min-w-0 flex flex-col flex-1">
								<h3 class="text-xl mb-1 pointer-events-none">
									{t(member.nameKey)} · {t(member.titleKey)}
								</h3>
								<p class="text-foreground/75 text-sm mb-4 pointer-events-none flex-1">{t(member.bioKey)}</p>
								<div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
									{
										member.website && (
											<a
												href={member.website}
												target="_blank"
												rel="noopener noreferrer"
												class="text-primary hover:underline relative z-10"
												data-team-link
											>
												{t('about.profiles.website')}
											</a>
										)
									}
									{
										member.linkedin && (
											<a
												href={member.linkedin}
												target="_blank"
												rel="noopener noreferrer"
												class="text-primary hover:underline relative z-10"
												data-team-link
											>
												{t('about.profiles.linkedin')}
											</a>
										)
									}
									{
										member.linkedinPending && (
											<span class="text-foreground/55 relative z-10">{t('about.team.ramiro.linkedinPending')}</span>
										)
									}
									{
										member.github && (
											<a
												href={member.github}
												target="_blank"
												rel="noopener noreferrer"
												class="text-primary hover:underline relative z-10"
												data-team-link
											>
												{t('about.profiles.github')}
											</a>
										)
									}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<div id="team-extended-sections" hidden={!extendedMemberIds.includes(defaultMemberId)}>
		{
			teamMembers
				.filter((m) => m.showExtendedProfile)
				.map((member) => (
					<TeamMemberExtended
						memberId={member.id}
						sections={member.extendedSections}
						hidden={member.id !== defaultMemberId}
					/>
				))
		}
	</div>

	<CtaSection />
</Layout>

<script define:vars={{ extendedMemberIds }}>
	const cards = document.querySelectorAll('.team-member-card');
	const extendedPanels = document.querySelectorAll('[data-member-extended]');
	const extendedWrapper = document.getElementById('team-extended-sections');

	function selectMember(memberId) {
		cards.forEach((card) => {
			const isSelected = card.getAttribute('data-team-member') === memberId;
			card.dataset.selected = isSelected ? 'true' : 'false';
			card.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
			card.tabIndex = isSelected ? 0 : -1;
		});

		const showExtended = extendedMemberIds.includes(memberId);
		if (extendedWrapper) {
			extendedWrapper.hidden = !showExtended;
		}

		extendedPanels.forEach((panel) => {
			panel.hidden = panel.getAttribute('data-member-extended') !== memberId;
		});
	}

	cards.forEach((card) => {
		card.addEventListener('click', (event) => {
			if (event.target.closest('[data-team-link]')) return;
			const memberId = card.getAttribute('data-team-member');
			if (memberId) selectMember(memberId);
		});

		card.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			const memberId = card.getAttribute('data-team-member');
			if (memberId) selectMember(memberId);
		});
	});
</script>
