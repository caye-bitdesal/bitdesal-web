---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="prices.hero.title">Transparent Pricing</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="prices.hero.subtitle">
				Clear hourly rates with volume discounts. All services include production code and complete documentation.
			</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="prices.basePricing.title">Single Rates</h2>
				<p class="text-lg text-foreground/70" data-i18n-key="prices.basePricing.subtitle">Hourly pricing by service type</p>
			</div>

			<div class="max-w-2xl mx-auto mb-1 md:mb-1">
				<div class="border-2 border-border rounded-lg p-8 hover:border-primary transition-colors">
					<div class="mb-4">
						<span class="text-4xl text-primary"><span data-i18n-key="prices.basePricing.price">120</span>€</span>
						<span class="text-foreground/70" data-i18n-key="prices.basePricing.perHour">/hour</span>
					</div>
					<p class="text-foreground/70" data-i18n-key="prices.basePricing.description">
						Applies to Android development, strategic consulting, and mentorship.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="prices.retainers.title">Monthly Retainers</h2>
				<p class="text-lg text-foreground/70" data-i18n-key="prices.retainers.subtitle">
					Save by committing to monthly volume
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
				<div class="bg-white border-2 border-border rounded-lg p-8">
					<h3 class="text-2xl mb-2" data-i18n-key="prices.retainers.standard.title">Standard</h3>
					<div class="mb-4">
						<div class="text-xl text-primary mb-1" data-i18n-key="prices.retainers.standard.volume">&lt; 20h/month</div>
						<div class="text-foreground/70" data-i18n-key="prices.retainers.standard.discount">Base rate</div>
					</div>
					<p class="text-foreground/70 mb-6" data-i18n-key="prices.retainers.standard.description">
						Perfect for one-off projects or occasional consulting
					</p>
					<ul class="space-y-2 mb-6">
						<li class="flex items-start gap-2">
							<span class="text-primary flex-shrink-0 mt-0.5">✓</span>
							<span class="text-sm">120-140€/h base rate</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-primary flex-shrink-0 mt-0.5">✓</span>
							<span class="text-sm">No commitment</span>
						</li>
					</ul>
				</div>

				<div class="bg-white border-2 border-primary rounded-lg p-8 relative">
					<div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-white px-4 py-1 rounded-full text-sm" data-i18n-key="prices.retainers.professional.popular">
						Most popular
					</div>
					<h3 class="text-2xl mb-2" data-i18n-key="prices.retainers.professional.title">Professional</h3>
					<div class="mb-4">
						<div class="text-xl text-primary mb-1" data-i18n-key="prices.retainers.professional.volume">20h+/month</div>
						<div class="text-primary font-medium" data-i18n-key="prices.retainers.professional.discount">5% discount</div>
					</div>
					<p class="text-foreground/70 mb-6" data-i18n-key="prices.retainers.professional.description">
						For continuous development and regular support
					</p>
					<ul class="space-y-2 mb-6">
						<li class="flex items-start gap-2">
							<span class="text-primary flex-shrink-0 mt-0.5">✓</span>
							<span class="text-sm">114-133€/h effective rate</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-primary flex-shrink-0 mt-0.5">✓</span>
							<span class="text-sm">Priority support</span>
						</li>
					</ul>
				</div>

				<div class="bg-white border-2 border-border rounded-lg p-8">
					<h3 class="text-2xl mb-2" data-i18n-key="prices.retainers.enterprise.title">Enterprise</h3>
					<div class="mb-4">
						<div class="text-xl text-primary mb-1" data-i18n-key="prices.retainers.enterprise.volume">40h+/month</div>
						<div class="text-primary font-medium" data-i18n-key="prices.retainers.enterprise.discount">10% discount</div>
					</div>
					<p class="text-foreground/70 mb-6" data-i18n-key="prices.retainers.enterprise.description">
						For large projects with significant dedication
					</p>
					<ul class="space-y-2 mb-6">
						<li class="flex items-start gap-2">
							<span class="text-primary flex-shrink-0 mt-0.5">✓</span>
							<span class="text-sm">108-126€/h effective rate</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-primary flex-shrink-0 mt-0.5">✓</span>
							<span class="text-sm">Dedicated support</span>
						</li>
					</ul>
				</div>
			</div>

			<div class="bg-white rounded-lg p-8 max-w-3xl mx-auto">
				<h3 class="text-2xl mb-6 text-center" data-i18n-key="prices.examples.title">Pricing Examples</h3>
				<p class="text-center text-foreground/70 mb-6" data-i18n-key="prices.examples.subtitle">
					Calculate your monthly investment based on needs
				</p>
				<div class="space-y-3">
					<div class="flex justify-between items-center py-3 border-b border-border">
						<span class="text-foreground/80" data-i18n-key="prices.examples.android20">Android Dev example</span>
					</div>
					<div class="flex justify-between items-center py-3 border-b border-border">
						<span class="text-foreground/80" data-i18n-key="prices.examples.consulting40">Consulting example</span>
					</div>
					<!-- Removed AI pricing example (AI-assisted work is not a standalone service offering). -->
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-12 text-center" data-i18n-key="prices.features.title">What All Services Include</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
				<div class="flex items-start gap-3"><span class="text-primary flex-shrink-0 mt-1">✓</span><span data-i18n-key="prices.features.feature1">Clean, documented production code</span></div>
				<div class="flex items-start gap-3"><span class="text-primary flex-shrink-0 mt-1">✓</span><span data-i18n-key="prices.features.feature2">Comprehensive testing and CI/CD</span></div>
				<div class="flex items-start gap-3"><span class="text-primary flex-shrink-0 mt-1">✓</span><span data-i18n-key="prices.features.feature3">Regular code reviews</span></div>
				<div class="flex items-start gap-3"><span class="text-primary flex-shrink-0 mt-1">✓</span><span data-i18n-key="prices.features.feature4">Async communication via Slack/Email</span></div>
				<div class="flex items-start gap-3"><span class="text-primary flex-shrink-0 mt-1">✓</span><span data-i18n-key="prices.features.feature5">Complete technical documentation</span></div>
				<div class="flex items-start gap-3"><span class="text-primary flex-shrink-0 mt-1">✓</span><span data-i18n-key="prices.features.feature6">Handoff for continuity</span></div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-primary text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-3xl md:text-4xl mb-6" data-i18n-key="prices.cta.title">Ready to start?</h2>
			<p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto" data-i18n-key="prices.cta.subtitle">
				Let's talk about your project and calculate the retainer that best fits your needs
			</p>
			<a
				href="/contact"
				class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors"
				data-i18n-key="prices.cta.button"
			>
				Request quote
			</a>
		</div>
	</section>
</Layout>

