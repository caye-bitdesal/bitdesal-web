---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import { useI18n } from '../i18n/useI18n';

const { t } = useI18n(Astro);

const roles = [
	{ id: 'bitdesal', items: 2, icon: 'briefcase' },
	{ id: 'kivra', items: 3, icon: 'phone' },
	{ id: 'optiscan', items: 2, icon: 'code' },
	{ id: 'frosmo', items: 2, icon: 'web' },
	{ id: 'sankarimedia', items: 2, icon: 'phone' },
	{ id: 'awimbawe', items: 2, icon: 'phone' },
	{ id: 'sicpa', items: 3, icon: 'code' },
	{ id: 'entropia', items: 1, icon: 'web' },
	{ id: 'comeks', items: 1, icon: 'web' },
] as const;

const roleIcons: Record<(typeof roles)[number]['icon'], string> = {
	briefcase: '<path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M4 12h16"/>',
	phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
	code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
	web: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
};

const skills = ['kotlin', 'compose', 'architecture', 'testing', 'ai', 'mentoring'] as const;
---

<Layout seo="about">
	<section class="py-10 bg-[#1a3a38] text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<p class="text-sm text-white/80">{t('about.stats.line')}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-start">
				<div class="flex-1 min-w-0">
					<h1 class="text-3xl md:text-4xl mb-2">{t('about.bio.name')}</h1>
					<p class="text-lg text-primary font-medium mb-6">{t('about.hero.role', t('about.bio.title'))}</p>

					<article class="space-y-4 text-lg text-foreground/80 leading-relaxed">
						<p>{t('about.bio.p1')}</p>
						<p>{t('about.bio.p2')}</p>
						<p>{t('about.bio.p3')}</p>
					</article>

					<div class="flex flex-wrap items-center gap-4 mt-8">
						<a href="https://www.linkedin.com/in/cayeruiz" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary hover:underline">
							<span>{t('about.profiles.linkedin')}</span>
						</a>
						<a href="https://github.com/caye-bitdesal" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary hover:underline">
							<span>{t('about.profiles.github')}</span>
						</a>
					</div>
				</div>

				<div class="w-full max-w-[240px] sm:max-w-[280px] mx-auto lg:mx-0 lg:shrink-0">
					<img
						src="/caye-ruiz-portrait.jpg"
						alt="Caye Ruiz, fundador de Bitdesal"
						class="w-full rounded-lg object-cover aspect-[3/4] shadow-lg"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-12">{t('about.journey.title')}</h2>
			<ol class="relative">
				{
					roles.map((role) => (
						<li class="group relative pl-14 pb-12 last:pb-0">
							<span class="absolute left-[15px] top-4 bottom-0 w-0.5 bg-primary/35 group-last:hidden" aria-hidden="true" />
							<span class="absolute left-0 top-0 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white ring-4 ring-secondary" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" set:html={roleIcons[role.icon]} />
							</span>
							<div class="relative rounded-lg p-4 -mx-2">
								<h3 class="text-xl mb-1">{t(`about.journey.${role.id}.role`)}</h3>
								<p class="text-foreground/70 mb-1">
									{t(`about.journey.${role.id}.company`)} · {t(`about.journey.${role.id}.location`)}
								</p>
								<p class="text-sm text-primary font-medium mb-3">{t(`about.journey.${role.id}.dates`)}</p>
								<ul class="list-disc list-outside ml-4 space-y-1.5 text-foreground/70">
									{Array.from({ length: role.items }, (_, i) => (
										<li>{t(`about.journey.${role.id}.item${i + 1}`)}</li>
									))}
								</ul>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8">{t('about.education.title')}</h2>
			<div>
				<h3 class="text-xl mb-1">{t('about.education.degree')}</h3>
				<p class="text-foreground/70 mb-1">{t('about.education.institution')}</p>
				<p class="text-sm text-primary font-medium">{t('about.education.dates')}</p>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-12 text-center">{t('about.skills.title')}</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
				{
					skills.map((skill) => (
						<div class="bg-white rounded-lg p-6">
							<h3 class="mb-2">{t(`about.skills.${skill}.title`)}</h3>
							<p class="text-sm text-foreground/70">{t(`about.skills.${skill}.description`)}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
