---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';

const roles = [
	{ id: 'bitdesal', items: 2, icon: 'briefcase' },
	{ id: 'kivra', items: 3, icon: 'phone' },
	{ id: 'optiscan', items: 2, icon: 'code' },
	{ id: 'frosmo', items: 2, icon: 'web' },
	{ id: 'sankarimedia', items: 2, icon: 'phone' },
	{ id: 'awimbawe', items: 2, icon: 'phone' },
	{ id: 'sicpa', items: 3, icon: 'code' },
	{ id: 'entropia', items: 1, icon: 'web' },
	{ id: 'comeks', items: 1, icon: 'web' },
] as const;

const roleIcons: Record<(typeof roles)[number]['icon'], string> = {
	briefcase:
		'<path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M4 12h16"/>',
	phone:
		'<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
	code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
	web: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
};

const skills = ['kotlin', 'compose', 'architecture', 'testing', 'ai', 'mentoring'] as const;
---

<Layout>
	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-start">
				<div class="flex-1 min-w-0">
					<h1 class="text-3xl md:text-4xl mb-2" data-i18n-key="about.bio.name">Caye Ruiz</h1>
					<p class="text-lg text-primary font-medium mb-6" data-i18n-key="about.bio.title">Founder</p>

					<article class="space-y-4 text-lg text-foreground/80 leading-relaxed">
						<p data-i18n-key="about.bio.p1"></p>
						<p data-i18n-key="about.bio.p2"></p>
						<p data-i18n-key="about.bio.p3"></p>
					</article>

					<div class="flex flex-wrap items-center gap-4 mt-8">
						<a
							href="https://www.linkedin.com/in/cayeruiz"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-primary hover:underline"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
							</svg>
							<span data-i18n-key="about.profiles.linkedin">LinkedIn</span>
						</a>
						<a
							href="https://github.com/caye-bitdesal"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-primary hover:underline"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
								<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
							</svg>
							<span data-i18n-key="about.profiles.github">GitHub</span>
						</a>
						<a
							href="https://app.shakersworks.com/profile/6a886539c137953ca80d6dbd"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-primary hover:underline"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
								<circle cx="12" cy="8" r="3.2"></circle>
								<path d="M5 19.2c.7-3.2 3.4-5.2 7-5.2s6.3 2 7 5.2" stroke-linecap="round"></path>
							</svg>
							<span data-i18n-key="about.profiles.shakers">Shakers</span>
						</a>
					</div>
				</div>

				<div class="w-full max-w-[240px] sm:max-w-[280px] mx-auto lg:mx-0 lg:shrink-0">
					<img
						src="/caye-ruiz-portrait.jpg"
						alt="Caye Ruiz, Founder of Bitdesal"
						class="w-full rounded-lg object-cover aspect-[3/4] shadow-lg"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-12" data-i18n-key="about.journey.title">Work experience</h2>

			<ol class="relative">
				{roles.map((role) => (
					<li class="group relative pl-14 pb-12 last:pb-0">
						<span
							class="absolute left-[15px] top-4 bottom-0 w-0.5 bg-primary/35 group-last:hidden"
							aria-hidden="true"
						></span>
						<span
							class="absolute left-0 top-0 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white ring-4 ring-secondary"
							aria-hidden="true"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="h-4 w-4"
								set:html={roleIcons[role.icon]}
							/>
						</span>
						<div class="relative rounded-lg p-4 -mx-2 transition-all duration-300 ease-out hover:scale-[1.02] hover:-translate-y-1 hover:shadow-xl hover:bg-white hover:z-10">
						<h3 class="text-xl mb-1 pt-0.5" data-i18n-key={`about.journey.${role.id}.role`}></h3>
						<p class="text-foreground/70 mb-1">
							<span data-i18n-key={`about.journey.${role.id}.company`}></span>
							<span aria-hidden="true"> · </span>
							<span data-i18n-key={`about.journey.${role.id}.location`}></span>
						</p>
						<p class="text-sm text-primary font-medium mb-3" data-i18n-key={`about.journey.${role.id}.dates`}></p>
						<ul class="list-disc list-outside ml-4 space-y-1.5 text-foreground/70">
							{Array.from({ length: role.items }, (_, i) => (
								<li data-i18n-key={`about.journey.${role.id}.item${i + 1}`}></li>
							))}
						</ul>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8" data-i18n-key="about.education.title">Education</h2>
			<div>
				<h3 class="text-xl mb-1" data-i18n-key="about.education.degree"></h3>
				<p class="text-foreground/70 mb-1" data-i18n-key="about.education.institution"></p>
				<p class="text-sm text-primary font-medium" data-i18n-key="about.education.dates"></p>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-12 text-center" data-i18n-key="about.skills.title">Skills</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
				{skills.map((skill) => (
					<div class="bg-white rounded-lg p-6">
						<h3 class="mb-2" data-i18n-key={`about.skills.${skill}.title`}></h3>
						<p class="text-sm text-foreground/70" data-i18n-key={`about.skills.${skill}.description`}></p>
					</div>
				))}
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
