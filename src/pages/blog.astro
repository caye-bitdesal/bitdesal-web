---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import { linkedInPosts } from '../data/linkedInPosts';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="blog.hero.title">Blog</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="blog.hero.subtitle">
				Articles from Bitdesal on LinkedIn about Android, AI and engineering
			</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{linkedInPosts.map((post) => <LinkedInPostCard post={post} />)}
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
