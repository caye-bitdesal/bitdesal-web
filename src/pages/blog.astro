---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import { linkedInPosts } from '../data/linkedInPosts';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="blog.hero.title">Blog</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="blog.hero.subtitle">
				Articles from Bitdesal on LinkedIn and Medium about Android, AI and engineering
			</p>
			<div class="flex justify-center items-center gap-6 mt-8">
				<a
					href="https://www.linkedin.com/company/bitdesal/"
					target="_blank"
					rel="noopener noreferrer"
					class="text-white/80 hover:text-white transition-colors"
					aria-label="Bitdesal on LinkedIn"
				>
					<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				</a>
				<a
					href="https://medium.com/@caye.suomi"
					target="_blank"
					rel="noopener noreferrer"
					class="text-white/80 hover:text-white transition-colors"
					aria-label="Caye Suomi on Medium"
				>
					<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{linkedInPosts.map((post) => <LinkedInPostCard post={post} />)}
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
