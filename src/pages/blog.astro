---
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostCard from '../components/LinkedInPostCard.astro';
import Layout from '../layouts/Layout.astro';
import { linkedInPosts } from '../data/linkedInPosts';
import { sitePath } from '../data/siteNav';
import { useI18n } from '../i18n/useI18n';
import { getCollection } from 'astro:content';

const { lang, t } = useI18n(Astro);

const localPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const audienceFilter = Astro.url.searchParams.get('audience');
---

<Layout seo="blog">
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6">{t('blog.hero.title')}</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto">{t('blog.hero.subtitle')}</p>
			<div class="flex flex-wrap justify-center gap-3 mt-8">
				<a href="?" class:list={['px-4 py-2 rounded-full text-sm border', !audienceFilter ? 'bg-white text-primary border-white' : 'border-white/40 text-white/90']}>Todos</a>
				<a href="?audience=business" class:list={['px-4 py-2 rounded-full text-sm border', audienceFilter === 'business' ? 'bg-white text-primary border-white' : 'border-white/40 text-white/90']}>Para empresas</a>
				<a href="?audience=technical" class:list={['px-4 py-2 rounded-full text-sm border', audienceFilter === 'technical' ? 'bg-white text-primary border-white' : 'border-white/40 text-white/90']}>Técnico</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
			{
				localPosts.length > 0 && (
					<div>
						<h2 class="text-2xl mb-6">En bitdesal.com</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							{localPosts
								.filter((p) => !audienceFilter || p.data.audience === audienceFilter)
								.map((post) => (
									<article class="border border-border rounded-xl p-6 hover:border-primary transition-colors">
										<p class="text-xs uppercase tracking-wide text-foreground/50 mb-2">
											{post.data.audience === 'business' ? 'Para empresas' : 'Técnico'}
										</p>
										<h3 class="text-xl mb-2">
											<a href={sitePath(`/blog/${post.id}`, lang)} class="hover:text-primary">
												{post.data.title}
											</a>
										</h3>
										<p class="text-foreground/70 text-sm">{post.data.description}</p>
									</article>
								))}
						</div>
					</div>
				)
			}

			<div>
				<h2 class="text-2xl mb-6">LinkedIn y Medium</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{linkedInPosts.map((post) => (
						<LinkedInPostCard post={post} />
					))}
				</div>
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
