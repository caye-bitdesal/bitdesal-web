---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="services.hero.title">Our Services</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="services.hero.subtitle">
				High-level technical solutions tailored to your business needs
			</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-24">
				<div>
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">⌁</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="services.android.title">
						Quality-Driven Android Development
					</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="services.android.description">
						Native Android application development with the latest technologies and industry best practices.
					</p>
					<div class="space-y-4 mb-8">
						<div>
							<h3 class="mb-2" data-i18n-key="services.android.techTitle">Technologies</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.android.tech1">100% Kotlin with Coroutines and Flow</li>
								<li data-i18n-key="services.android.tech2">Jetpack Compose for declarative UI</li>
								<li data-i18n-key="services.android.tech3">MVVM/MVI Architecture with Clean Architecture</li>
								<li data-i18n-key="services.android.tech4">Hilt for dependency injection</li>
								<li data-i18n-key="services.android.tech5">Room, Retrofit, Coil and more</li>
								<li data-i18n-key="services.android.tech6">Material Design 3</li>
							</ul>
						</div>
						<div>
							<h3 class="mb-2" data-i18n-key="services.android.servicesTitle">Services included</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.android.service1">App development from scratch</li>
								<li data-i18n-key="services.android.service2">Java to Kotlin migration</li>
								<li data-i18n-key="services.android.service3">Legacy code modernization</li>
								<li data-i18n-key="services.android.service4">Architecture and code review</li>
								<li data-i18n-key="services.android.service5">Testing and CI/CD</li>
							</ul>
						</div>
					</div>
				</div>
				<div class="bg-secondary rounded-lg p-8">
					<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
						<span class="text-white/20 text-6xl font-semibold">⟡</span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-24">
				<div class="order-2 lg:order-1">
					<div class="bg-secondary rounded-lg p-8">
						<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
							<span class="text-white/20 text-6xl font-semibold">◎</span>
						</div>
					</div>
				</div>
				<div class="order-1 lg:order-2">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">AI</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="services.ai.title">Artificial Intelligence</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="services.ai.description">
						Implementation of AI solutions that generate real value.
					</p>
					<div class="space-y-4 mb-8">
						<div>
							<h3 class="mb-2" data-i18n-key="services.ai.agentsTitle">Agents and Automation</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.ai.agent1">Intelligent chatbots</li>
								<li data-i18n-key="services.ai.agent2">AI assistants</li>
								<li data-i18n-key="services.ai.agent3">Workflow automation</li>
								<li data-i18n-key="services.ai.agent4">NLP</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-24">
				<div>
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">1:1</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="services.mentorship.title">Technical Mentorship</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="services.mentorship.description">
						Personalized training for developers and teams.
					</p>
					<div class="space-y-4 mb-8">
						<div>
							<h3 class="mb-2" data-i18n-key="services.mentorship.programsTitle">Available programs</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.mentorship.program1">Personalized mentorship</li>
								<li data-i18n-key="services.mentorship.program2">Team training</li>
								<li data-i18n-key="services.mentorship.program3">Code reviews</li>
								<li data-i18n-key="services.mentorship.program4">Workshops</li>
							</ul>
						</div>
						<div>
							<h3 class="mb-2" data-i18n-key="services.mentorship.topicsTitle">Topics covered</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.mentorship.topic1">Advanced Kotlin and Compose</li>
								<li data-i18n-key="services.mentorship.topic2">Software architecture</li>
								<li data-i18n-key="services.mentorship.topic3">Testing and best practices</li>
								<li data-i18n-key="services.mentorship.topic4">Performance and optimization</li>
							</ul>
						</div>
					</div>
				</div>
				<div class="bg-secondary rounded-lg p-8">
					<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
						<span class="text-white/20 text-6xl font-semibold">↟</span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div class="order-2 lg:order-1">
					<div class="bg-secondary rounded-lg p-8">
						<div class="aspect-square bg-gradient-to-br from-primary to-primary/80 rounded-lg flex items-center justify-center">
							<span class="text-white/20 text-6xl font-semibold">✦</span>
						</div>
					</div>
				</div>
				<div class="order-1 lg:order-2">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-6">
						<span class="text-primary text-xl font-semibold">⋄</span>
					</div>
					<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="services.consulting.title">Strategic Consulting</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="services.consulting.description">
						High-level technical advice.
					</p>
					<div class="space-y-4 mb-8">
						<div>
							<h3 class="mb-2" data-i18n-key="services.consulting.servicesTitle">Consulting services</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.consulting.service1">Architecture and code audit</li>
								<li data-i18n-key="services.consulting.service2">Technology stack definition</li>
								<li data-i18n-key="services.consulting.service3">Technical roadmap</li>
								<li data-i18n-key="services.consulting.service4">Team evaluation</li>
							</ul>
						</div>
						<div>
							<h3 class="mb-2" data-i18n-key="services.consulting.expertiseTitle">Areas of expertise</h3>
							<ul class="list-disc list-inside space-y-2 text-foreground/80">
								<li data-i18n-key="services.consulting.expertise1">Mobile-first strategy</li>
								<li data-i18n-key="services.consulting.expertise2">Cloud-native migration</li>
								<li data-i18n-key="services.consulting.expertise3">AI adoption</li>
								<li data-i18n-key="services.consulting.expertise4">Agile and DevOps</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-3xl md:text-4xl mb-6" data-i18n-key="services.cta.title">Need something more specific?</h2>
			<p class="text-lg text-foreground/80 mb-8 max-w-2xl mx-auto" data-i18n-key="services.cta.subtitle">
				Every project is unique.
			</p>
			<a
				href="/contact"
				class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3 rounded-lg hover:bg-primary/90 transition-colors"
				data-i18n-key="services.cta.button"
			>
				Talk to us
			</a>
		</div>
	</section>
</Layout>

