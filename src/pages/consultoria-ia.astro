---
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Layout from '../layouts/Layout.astro';
import { BOOKING_URL } from '../data/siteConstants';
import { sitePath } from '../data/siteNav';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);

const painKeys = [
	'budgets',
	'orders',
	'appointments',
	'quotes',
	'forms',
	'copy',
	'docs',
] as const;

const workSteps = [
	'home.howIWork.steps.call',
	'home.howIWork.steps.study',
	'home.howIWork.steps.build',
	'home.howIWork.steps.handoff',
] as const;

const faqItems = [
	{ qKey: 'home.faq.items.duration.q', aKey: 'home.faq.items.duration.a' },
	{ qKey: 'home.faq.items.tools.q', aKey: 'home.faq.items.tools.a' },
	{ qKey: 'home.faq.items.worth.q', aKey: 'home.faq.items.worth.a' },
	{ qKey: 'home.faq.items.after.q', aKey: 'home.faq.items.after.a' },
	{ qKey: 'home.faq.items.remote.q', aKey: 'home.faq.items.remote.a' },
	{ qKey: 'iaPage.faq.security.q', aKey: 'iaPage.faq.security.a' },
	{ qKey: 'iaPage.faq.tech.q', aKey: 'iaPage.faq.tech.a' },
];
---

<Layout seo="iaConsulting">
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/85 mb-4">{t('iaPage.hero.badge')}</p>
			<h1 class="text-4xl md:text-5xl mb-6">{t('iaPage.hero.title')}</h1>
			<p class="text-xl text-white/90 mb-8">{t('iaPage.hero.subtitle')}</p>
			<a
				href={BOOKING_URL}
				class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors dark:bg-[var(--cta-cream)] dark:text-[#0b1111] dark:hover:bg-[#e8e4dc]"
			>
				{t('common.bookCta')}
			</a>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl text-center mb-12">{t('iaPage.painPoints.title')}</h2>
			<div class="space-y-6">
				{
					painKeys.map((key) => (
						<article class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-sm">
							<p class="text-lg md:text-xl font-medium text-foreground leading-snug mb-4">
								«{t(`iaPage.painPoints.items.${key}.problem`)}»
							</p>
							<p class="text-foreground/75 leading-relaxed">{t(`iaPage.painPoints.items.${key}.solution`)}</p>
						</article>
					))
				}
			</div>
			<div class="text-center mt-12">
				<p class="text-lg text-foreground/85 mb-6">{t('iaPage.painPoints.closing')}</p>
				<a
					href={BOOKING_URL}
					class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-8 py-3 rounded-lg hover:bg-primary/90 transition-colors"
				>
					{t('common.bookCta')}
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-background">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl text-center mb-12">{t('home.howIWork.title')}</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{
					workSteps.map((stepKey, index) => (
						<div class="bg-card rounded-lg p-6 shadow-sm border border-border">
							<div class="w-10 h-10 bg-primary text-primary-foreground rounded-lg flex items-center justify-center mb-4">{index + 1}</div>
							<h3 class="mb-2">{t(`${stepKey}.title`)}</h3>
							<p class="text-foreground/70 text-sm">{t(`${stepKey}.description`)}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8">{t('iaPage.pricingSummary.title')}</h2>
			<ul class="space-y-4 text-foreground/80">
				<li>{t('iaPage.pricingSummary.study')}</li>
				<li>{t('iaPage.pricingSummary.express')}</li>
				<li>{t('iaPage.pricingSummary.custom')}</li>
				<li>{t('iaPage.pricingSummary.support')}</li>
			</ul>
			<a href={`${sitePath('/pricing', lang)}#ia`} class="inline-flex items-center gap-2 text-primary mt-8 hover:gap-3 transition-all">
				{t('iaPage.pricingSummary.details')}
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</section>

	<FaqSection titleKey="home.faq.title" items={faqItems} />

	<CtaSection variant="ia" />
</Layout>
