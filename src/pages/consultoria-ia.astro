---
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Layout from '../layouts/Layout.astro';
import { sectorLandings } from '../data/sectorLandings';
import { BOOKING_URL, SITE_ORIGIN } from '../data/siteConstants';
import { ORG_ID } from '../data/siteJsonLd';
import { sitePath } from '../data/siteNav';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);

const canonicalPath =
	Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
		? Astro.url.pathname
		: `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, SITE_ORIGIN).href;

const painKeys = ['budgets', 'orders', 'appointments', 'quotes', 'forms', 'copy', 'docs'] as const;

const automateKeys = ['quotes', 'followup', 'appointments', 'jobs', 'orders', 'invoices', 'whatsapp'] as const;

const automateHref: Record<(typeof automateKeys)[number], string> = {
	quotes: '/automatizacion-procesos-ia/',
	followup: '/automatizacion-procesos-ia/',
	appointments: '/automatizacion-procesos-ia/',
	jobs: '/automatizacion-procesos-ia/',
	orders: '/automatizacion-procesos-ia/',
	invoices: '/automatizacion-procesos-ia/',
	whatsapp: '/agentes-ia-empresas/',
};

const workSteps = [
	'home.howIWork.steps.call',
	'home.howIWork.steps.study',
	'home.howIWork.steps.build',
	'home.howIWork.steps.handoff',
] as const;

const sectorModules = import.meta.glob('./consultoria-ia/**/*.astro');
const publishedSectors = sectorLandings.filter((sector) =>
	Object.keys(sectorModules).some((path) => path.includes(`${sector.slug}.astro`) || path.includes(`${sector.slug}/`)),
);

const faqItems = [
	{ qKey: 'iaPage.faqExtra.cost.q', aKey: 'iaPage.faqExtra.cost.a' },
	{ qKey: 'iaPage.faqExtra.software.q', aKey: 'iaPage.faqExtra.software.a' },
	{
		qKey: 'iaPage.faqExtra.agent.q',
		aKey: 'iaPage.faqExtra.agent.a',
		linkHref: '/agentes-ia-empresas/',
		linkLabelKey: 'iaPage.faqExtra.agent.link',
	},
	{ qKey: 'home.faq.items.duration.q', aKey: 'home.faq.items.duration.a' },
	{ qKey: 'home.faq.items.tools.q', aKey: 'home.faq.items.tools.a' },
	{ qKey: 'home.faq.items.worth.q', aKey: 'home.faq.items.worth.a' },
	{ qKey: 'home.faq.items.after.q', aKey: 'home.faq.items.after.a' },
	{ qKey: 'home.faq.items.remote.q', aKey: 'home.faq.items.remote.a' },
	{ qKey: 'iaPage.faq.security.q', aKey: 'iaPage.faq.security.a' },
	{ qKey: 'iaPage.faq.tech.q', aKey: 'iaPage.faq.tech.a' },
];

const serviceNames: Record<string, string> = {
	es: 'Consultoría de IA para empresas',
	en: 'AI consulting for companies',
	fi: 'Tekoälykonsultointi yrityksille',
};

const serviceJsonLd = {
	'@type': 'Service',
	'@id': `${canonical}#service`,
	name: serviceNames[lang] ?? serviceNames.es,
	serviceType: serviceNames[lang] ?? serviceNames.es,
	description: t('iaPage.intro.p1'),
	provider: { '@id': ORG_ID },
	areaServed: {
		'@type': 'Country',
		name: lang === 'en' ? 'Spain' : lang === 'fi' ? 'Espanja' : 'España',
	},
	url: canonical,
};
---

<Layout seo="iaConsulting" breadcrumbLabel={t('iaPage.hero.badge')} jsonLd={[serviceJsonLd]}>
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6">
				<span class="block text-xs font-semibold uppercase tracking-[0.2em] text-white/85 mb-4">
					{t('iaPage.hero.badge')}
				</span>
				{t('iaPage.hero.title')}
			</h1>
			<p class="text-xl text-white/90 mb-8">{t('iaPage.hero.subtitle')}</p>
			<a
				href={BOOKING_URL}
				class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors dark:bg-[var(--cta-cream)] dark:text-[#0b1111] dark:hover:bg-[#e8e4dc]"
			>
				{t('common.bookCta')}
			</a>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-lg text-foreground/80 leading-relaxed">
			<p>{t('iaPage.intro.p1')}</p>
			<p>{t('iaPage.intro.p2')}</p>
			<p>{t('iaPage.intro.p3')}</p>
			<h2 class="text-2xl md:text-3xl text-foreground pt-4">{t('iaPage.related.title')}</h2>
			<ul class="space-y-3 text-base">
				<li>
					<a href="/automatizacion-procesos-ia/" class="text-primary font-medium hover:underline">
						{t('iaPage.related.processes')}
					</a>
				</li>
				<li>
					<a href="/agentes-ia-empresas/" class="text-primary font-medium hover:underline">
						{t('iaPage.related.agents')}
					</a>
				</li>
				<li>
					<a href="/consultoria-ia-alicante-elche/" class="text-primary font-medium hover:underline">
						{t('iaPage.related.local')}
					</a>
				</li>
				<li>
					<a href={`${sitePath('/casos-y-precios', lang)}#ia`} class="text-primary font-medium hover:underline">
						{t('iaPage.related.pricing')}
					</a>
				</li>
				<li>
					<a href={sitePath('/contacto', lang)} class="text-primary font-medium hover:underline">
						{t('iaPage.related.contact')}
					</a>
				</li>
			</ul>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl text-center mb-12">{t('iaPage.painPoints.title')}</h2>
			<div class="space-y-6">
				{
					painKeys.map((key) => (
						<article class="rounded-2xl border border-border bg-card p-6 md:p-8 shadow-sm">
							<h3 class="text-lg md:text-xl font-medium text-foreground leading-snug mb-4">
								«{t(`iaPage.painPoints.items.${key}.problem`)}»
							</h3>
							<p class="text-foreground/75 leading-relaxed">{t(`iaPage.painPoints.items.${key}.solution`)}</p>
						</article>
					))
				}
			</div>
			<div class="text-center mt-12">
				<p class="text-lg text-foreground/85 mb-6">{t('iaPage.painPoints.closing')}</p>
				<a
					href={BOOKING_URL}
					class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-8 py-3 rounded-lg hover:bg-primary/90 transition-colors"
				>
					{t('common.bookCta')}
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-4">{t('iaPage.automate.title')}</h2>
			<p class="text-lg text-foreground/80 leading-relaxed mb-10">{t('iaPage.automate.lead')}</p>
			<div class="space-y-10">
				{
					automateKeys.map((key) => (
						<article>
							<h3 class="text-xl mb-3">{t(`iaPage.automate.items.${key}.title`)}</h3>
							<p class="text-foreground/80 leading-relaxed">{t(`iaPage.automate.items.${key}.body`)}</p>
							<p class="mt-3">
								<a href={automateHref[key]} class="text-primary font-medium hover:underline">
									{t(`iaPage.automate.items.${key}.link`)}
								</a>
							</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-lg text-foreground/80 leading-relaxed">
			<h2 class="text-3xl md:text-4xl text-foreground">{t('iaPage.limits.title')}</h2>
			<p>{t('iaPage.limits.p1')}</p>
			<p>{t('iaPage.limits.p2')}</p>
			<p>{t('iaPage.limits.p3')}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-3xl mb-10 space-y-4 text-lg text-foreground/80 leading-relaxed">
				<h2 class="text-3xl md:text-4xl text-foreground">{t('iaPage.sectors.title')}</h2>
				<p>{t('iaPage.sectors.p1')}</p>
				<p>{t('iaPage.sectors.p2')}</p>
			</div>
			{
				publishedSectors.length > 0 && (
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
						{publishedSectors.map((sector) => (
							<a
								href={sector.href}
								class="rounded-2xl border border-border bg-card p-6 hover:border-primary hover:shadow-md transition-all"
							>
								<h3 class="text-xl">{sector.title}</h3>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>

	<section class="py-16 md:py-24 bg-background">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl text-center mb-12">{t('home.howIWork.title')}</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{
					workSteps.map((stepKey, index) => (
						<div class="bg-card rounded-lg p-6 shadow-sm border border-border">
							<div class="w-10 h-10 bg-primary text-primary-foreground rounded-lg flex items-center justify-center mb-4">
								{index + 1}
							</div>
							<h3 class="mb-2">{t(`${stepKey}.title`)}</h3>
							<p class="text-foreground/70 text-sm">{t(`${stepKey}.description`)}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16 md:py-20 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-4">{t('iaPage.pricing.title')}</h2>
			<p class="text-lg text-foreground/80 leading-relaxed mb-8">{t('iaPage.pricing.lead')}</p>
			<ul class="space-y-4 text-foreground/80 leading-relaxed">
				<li>{t('iaPage.pricingSummary.study')}</li>
				<li>{t('iaPage.pricingSummary.express')}</li>
				<li>{t('iaPage.pricingSummary.custom')}</li>
				<li>{t('iaPage.pricingSummary.support')}</li>
			</ul>
			<p class="mt-8">
				<a
					href={`${sitePath('/casos-y-precios', lang)}#precios`}
					class="inline-flex items-center gap-2 text-primary text-lg font-medium hover:gap-3 transition-all"
				>
					{t('iaPage.pricingSummary.details')}
					<span aria-hidden="true">→</span>
				</a>
			</p>
		</div>
	</section>

	<FaqSection titleKey="home.faq.title" items={faqItems} />

	<CtaSection variant="ia" />
</Layout>
