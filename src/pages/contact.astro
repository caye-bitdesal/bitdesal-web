---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6" data-i18n-key="contact.hero.title">Contact</h1>
			<p class="text-xl text-white/90 max-w-3xl mx-auto" data-i18n-key="contact.hero.subtitle">
				Let's talk about your project.
			</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<div>
					<h2 class="text-3xl mb-6" data-i18n-key="contact.form.title">Send us a message</h2>
					<p class="text-lg text-foreground/80 mb-8" data-i18n-key="contact.form.description">
						Fill out the form and we'll get back to you as soon as possible.
					</p>

					<div id="contact-success" class="hidden bg-primary/10 border border-primary text-primary px-6 py-4 rounded-lg mb-6">
						<p data-i18n-key="contact.form.success">✓ Message sent successfully. We'll get back to you soon!</p>
					</div>

					<form id="contact-form" class="space-y-6">
						<div>
							<label for="name" class="block mb-2"><span data-i18n-key="contact.form.name">Name</span> *</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="w-full px-4 py-3 rounded-lg border border-border focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
								data-i18n-key="contact.form.namePlaceholder"
								data-i18n-attr="placeholder"
								placeholder="Your name"
							/>
						</div>

						<div>
							<label for="email" class="block mb-2"><span data-i18n-key="contact.form.email">Email</span> *</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="w-full px-4 py-3 rounded-lg border border-border focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
								data-i18n-key="contact.form.emailPlaceholder"
								data-i18n-attr="placeholder"
								placeholder="your@email.com"
							/>
						</div>

						<div>
							<label for="company" class="block mb-2" data-i18n-key="contact.form.company">Company</label>
							<input
								type="text"
								id="company"
								name="company"
								class="w-full px-4 py-3 rounded-lg border border-border focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
								data-i18n-key="contact.form.companyPlaceholder"
								data-i18n-attr="placeholder"
								placeholder="Your company name (optional)"
							/>
						</div>

						<div>
							<label for="service" class="block mb-2"><span data-i18n-key="contact.form.service">Service of interest</span> *</label>
							<select
								id="service"
								name="service"
								required
								class="w-full px-4 py-3 rounded-lg border border-border focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
							>
								<option value="" data-i18n-key="contact.form.selectService">Select a service</option>
								<option value="android" data-i18n-key="contact.form.android">Android Development</option>
								<option value="ai" data-i18n-key="contact.form.ai">Artificial Intelligence</option>
								<option value="mentorship" data-i18n-key="contact.form.mentorship">Mentorship</option>
								<option value="consulting" data-i18n-key="contact.form.consulting">Strategic Consulting</option>
								<option value="other" data-i18n-key="contact.form.other">Other</option>
							</select>
						</div>

						<div>
							<label for="message" class="block mb-2"><span data-i18n-key="contact.form.message">Message</span> *</label>
							<textarea
								id="message"
								name="message"
								required
								rows="6"
								class="w-full px-4 py-3 rounded-lg border border-border focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
								data-i18n-key="contact.form.messagePlaceholder"
								data-i18n-attr="placeholder"
								placeholder="Tell us about your project or need..."
							></textarea>
						</div>

						<button
							type="submit"
							class="w-full bg-primary text-white px-8 py-3 rounded-lg hover:bg-primary/90 transition-colors inline-flex items-center justify-center gap-2"
						>
							<span data-i18n-key="contact.form.submit">Send message</span> <span aria-hidden="true">→</span>
						</button>
					</form>
				</div>

				<div>
					<h2 class="text-3xl mb-6" data-i18n-key="contact.info.title">Contact information</h2>

					<div class="space-y-6 mb-12">
						<div class="flex items-start gap-4">
							<div class="w-12 h-12 bg-secondary rounded-lg flex items-center justify-center flex-shrink-0">
								<span class="text-primary font-semibold">@</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="contact.info.email.title">Email</h3>
								<a href="mailto:contact@bitdesal.com" class="text-primary hover:underline" data-i18n-key="contact.info.email.address">
									contact@bitdesal.com
								</a>
								<p class="text-sm text-foreground/70 mt-1" data-i18n-key="contact.info.email.description">Response in less than 24h</p>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div class="w-12 h-12 bg-secondary rounded-lg flex items-center justify-center flex-shrink-0">
								<span class="text-primary font-semibold">in</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="contact.info.linkedin.title">LinkedIn</h3>
								<a
									href="https://linkedin.com/in/bitdesal"
									target="_blank"
									rel="noopener noreferrer"
									class="text-primary hover:underline"
								>
									linkedin.com/in/bitdesal
								</a>
								<p class="text-sm text-foreground/70 mt-1" data-i18n-key="contact.info.linkedin.description">Follow us for technical content</p>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div class="w-12 h-12 bg-secondary rounded-lg flex items-center justify-center flex-shrink-0">
								<span class="text-primary font-semibold">⟡</span>
							</div>
							<div>
								<h3 class="mb-1" data-i18n-key="contact.info.location.title">Location</h3>
								<p class="text-foreground/80" data-i18n-key="contact.info.location.value">Remote-first</p>
								<p class="text-sm text-foreground/70 mt-1" data-i18n-key="contact.info.location.description">We work with clients worldwide</p>
							</div>
						</div>
					</div>

					<div class="bg-secondary rounded-lg p-8">
						<h3 class="text-xl mb-4" data-i18n-key="contact.schedule.title">Response schedule</h3>
						<p class="text-foreground/80 mb-4" data-i18n-key="contact.schedule.description">
							We respond to emails and messages Monday through Friday.
						</p>
						<div class="space-y-2 text-sm text-foreground/70">
							<p>
								<strong data-i18n-key="contact.schedule.weekdays">Monday - Friday</strong>:
								<span data-i18n-key="contact.schedule.weekdaysTime">9:00 AM - 6:00 PM CET</span>
							</p>
							<p>
								<strong data-i18n-key="contact.schedule.weekend">Saturday - Sunday</strong>:
								<span data-i18n-key="contact.schedule.weekendTime">Closed</span>
							</p>
							<p class="pt-2" data-i18n-key="contact.schedule.emergency">
								For emergencies on active projects, we provide a direct communication channel.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-12 text-center" data-i18n-key="contact.faq.title">Frequently Asked Questions</h2>

			<div class="max-w-3xl mx-auto space-y-6">
				<div class="bg-white rounded-lg p-6">
					<h3 class="mb-2" data-i18n-key="contact.faq.q1.question">Question</h3>
					<p class="text-foreground/70" data-i18n-key="contact.faq.q1.answer">Answer</p>
				</div>
				<div class="bg-white rounded-lg p-6">
					<h3 class="mb-2" data-i18n-key="contact.faq.q2.question">Question</h3>
					<p class="text-foreground/70" data-i18n-key="contact.faq.q2.answer">Answer</p>
				</div>
				<div class="bg-white rounded-lg p-6">
					<h3 class="mb-2" data-i18n-key="contact.faq.q3.question">Question</h3>
					<p class="text-foreground/70" data-i18n-key="contact.faq.q3.answer">Answer</p>
				</div>
				<div class="bg-white rounded-lg p-6">
					<h3 class="mb-2" data-i18n-key="contact.faq.q4.question">Question</h3>
					<p class="text-foreground/70" data-i18n-key="contact.faq.q4.answer">Answer</p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form');
	const success = document.getElementById('contact-success');

	if (form && success) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			success.classList.remove('hidden');
			form.reset();
			window.setTimeout(() => success.classList.add('hidden'), 3000);
		});
	}
</script>

