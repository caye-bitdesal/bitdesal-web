---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import PricingOffer from '../components/PricingOffer.astro';

const principles = [
	{
		id: 'find',
		icon: 'search',
		titleKey: 'pricing.principles.find.title',
		title: 'Find the bureaucracy',
		descKey: 'pricing.principles.find.description',
		description:
			'We map the approvals, documents and handoffs that slow the company down, and estimate the work before development starts.',
	},
	{
		id: 'connect',
		icon: 'link',
		titleKey: 'pricing.principles.connect.title',
		title: 'Digitize and connect AI',
		descKey: 'pricing.principles.connect.description',
		description:
			'We turn that process into software and place AI where it removes repetition, inside the tools the team already uses.',
	},
	{
		id: 'operate',
		icon: 'rocket',
		titleKey: 'pricing.principles.operate.title',
		title: 'Leave it in daily use',
		descKey: 'pricing.principles.operate.description',
		description:
			'Training, code and documentation stay with your team. After launch, support continues through monthly hour bundles.',
	},
] as const;

const phases = [
	{
		titleKey: 'pricing.phases.items.assessment.title',
		title: 'Assessment and requirements',
		descKey: 'pricing.phases.items.assessment.description',
		description: 'Goals, constraints and the underlying problem we need to solve.',
		shortKey: 'pricing.phases.items.assessment.short',
		short: 'Assessment',
		hours: '6–10 h',
		amount: '€210–350',
	},
	{
		titleKey: 'pricing.phases.items.study.title',
		title: 'Process and systems study',
		descKey: 'pricing.phases.items.study.description',
		description: 'Interviews, real workflows, exceptions and existing integrations.',
		shortKey: 'pricing.phases.items.study.short',
		short: 'Process study',
		hours: '10–20 h',
		amount: '€350–700',
	},
	{
		titleKey: 'pricing.phases.items.redesign.title',
		title: 'Solution redesign',
		descKey: 'pricing.phases.items.redesign.description',
		description: 'We define how the process should work before automating it.',
		shortKey: 'pricing.phases.items.redesign.short',
		short: 'Redesign',
		hours: '8–15 h',
		amount: '€280–525',
	},
	{
		titleKey: 'pricing.phases.items.technology.title',
		title: 'Technology selection',
		descKey: 'pricing.phases.items.technology.description',
		description: 'Architecture, tools, integrations and security criteria.',
		shortKey: 'pricing.phases.items.technology.short',
		short: 'Technology',
		hours: '6–12 h',
		amount: '€210–420',
	},
	{
		titleKey: 'pricing.phases.items.plan.title',
		title: 'Phased implementation plan',
		descKey: 'pricing.phases.items.plan.description',
		description: 'A prioritized roadmap that starts with the highest-value work.',
		shortKey: 'pricing.phases.items.plan.short',
		short: 'Phased plan',
		hours: '5–8 h',
		amount: '€175–280',
	},
	{
		titleKey: 'pricing.phases.items.delivery.title',
		title: 'Implementation, training and delivery',
		descKey: 'pricing.phases.items.delivery.description',
		description: 'Development, testing, launch and hands-on team training.',
		shortKey: 'pricing.phases.items.delivery.short',
		short: 'Implementation',
		hours: '15–30 h',
		amount: '€525–1,050',
	},
] as const;

const bundles = [
	{ labelKey: 'pricing.bundles.h5', label: '5 h / month', amount: '€175' },
	{ labelKey: 'pricing.bundles.h10', label: '10 h / month', amount: '€350' },
	{ labelKey: 'pricing.bundles.h20', label: '20 h / month', amount: '€700' },
] as const;
---

<Layout>
	<PricingOffer />

	<section id="approach" class="scroll-mt-20 py-20 md:py-28 bg-secondary">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-14">
				<p class="text-xs tracking-[0.18em] uppercase text-primary/80 mb-3" data-i18n-key="pricing.approach.eyebrow">
					The approach
				</p>
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="pricing.approach.title">
					Three principles behind the process
				</h2>
				<p class="text-lg text-foreground/70" data-i18n-key="pricing.approach.subtitle">
					A method designed to make the investment visible in daily operations, not only in a presentation.
				</p>
				<p class="text-base text-foreground/80 mt-4" data-i18n-key="pricing.approach.strategy">
					Consulting to digitize how a company works and integrate AI where it cuts bureaucracy: approvals,
					documents, reporting and the tasks that still move by hand.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{
					principles.map((principle) => (
						<article class="bg-white rounded-2xl p-8 shadow-sm">
							<div class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-secondary text-primary mb-5">
								{principle.icon === 'search' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
										<circle cx="11" cy="11" r="7" />
										<path d="m20 20-3.5-3.5" stroke-linecap="round" />
									</svg>
								)}
								{principle.icon === 'link' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
										<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
								{principle.icon === 'rocket' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
										<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09Z" stroke-linecap="round" stroke-linejoin="round" />
										<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Z" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
							</div>
							<h3 class="text-xl mb-2" data-i18n-key={principle.titleKey}>
								{principle.title}
							</h3>
							<p class="text-foreground/70 leading-relaxed" data-i18n-key={principle.descKey}>
								{principle.description}
							</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-20 md:py-28 bg-white">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<p class="text-xs tracking-[0.18em] uppercase text-primary/80 mb-3" data-i18n-key="pricing.phases.eyebrow">
					The process
				</p>
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="pricing.phases.title">Service phases</h2>
				<p class="text-lg text-foreground/70" data-i18n-key="pricing.phases.subtitle">
					Hours are indicative; the final scope and fixed estimate are confirmed after the initial assessment.
				</p>
			</div>

			<ol>
				{
					phases.map((phase, index) => (
						<li class="flex items-start justify-between gap-6 py-5 border-b border-border">
							<div class="flex items-start gap-4 min-w-0">
								<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm text-white">
									{index + 1}
								</span>
								<div class="min-w-0 pt-0.5">
									<h3 class="text-base" data-i18n-key={phase.titleKey}>
										{phase.title}
									</h3>
									<p class="text-sm text-foreground/60 mt-0.5" data-i18n-key={phase.descKey}>
										{phase.description}
									</p>
								</div>
							</div>
							<div class="text-right shrink-0 pt-0.5">
								<p class="text-sm">{phase.hours}</p>
								<p class="text-sm text-primary">{phase.amount}</p>
							</div>
						</li>
					))
				}
			</ol>

			<div class="mt-8 flex items-start gap-3 rounded-xl bg-[#f3f4f6] px-5 py-4 text-sm text-foreground/80">
				<span
					class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-foreground/40 text-[11px] text-foreground/70"
					aria-hidden="true"
				>
					i
				</span>
				<p>
					<span class="font-medium text-foreground" data-i18n-key="pricing.phases.coreLabel">Core idea:</span>
					{' '}
					<span data-i18n-key="pricing.phases.core">
						diagnosing and redesigning before building prevents technology from merely accelerating an inefficient
						process.
					</span>
				</p>
			</div>
		</div>
	</section>

	<section class="py-20 md:py-28 bg-secondary">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center max-w-2xl mx-auto mb-12">
				<p class="text-xs tracking-[0.18em] uppercase text-primary/80 mb-3" data-i18n-key="pricing.investment.eyebrow">
					Investment
				</p>
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="pricing.investment.title">Clear rates, no surprises</h2>
				<p class="text-lg text-foreground/70" data-i18n-key="pricing.investment.subtitle">
					Everything is calculated at €35/hour. This table shows an indicative project for a small or medium-sized
					company.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-6 items-stretch">
				<div class="bg-white rounded-xl overflow-hidden shadow-sm border border-black/5">
					<table class="w-full text-sm">
						<thead class="bg-[#f4f7f6] text-foreground/70">
							<tr>
								<th class="text-left font-medium px-4 py-3" data-i18n-key="pricing.investment.phase">Phase</th>
								<th class="text-right font-medium px-4 py-3" data-i18n-key="pricing.investment.hours">Hours</th>
								<th class="text-right font-medium px-4 py-3" data-i18n-key="pricing.investment.amount">Amount</th>
							</tr>
						</thead>
						<tbody>
							{
								phases.map((phase, index) => (
									<tr class="border-t border-border">
										<td class="px-4 py-3">
											{index + 1}. <span data-i18n-key={phase.shortKey}>{phase.short}</span>
										</td>
										<td class="px-4 py-3 text-right text-foreground/70">{phase.hours}</td>
										<td class="px-4 py-3 text-right text-primary">{phase.amount}</td>
									</tr>
								))
							}
							<tr class="border-t border-border font-medium">
								<td class="px-4 py-3" data-i18n-key="pricing.investment.total">Complete project</td>
								<td class="px-4 py-3 text-right">50–95 h</td>
								<td class="px-4 py-3 text-right text-primary">€1,750–3,325</td>
							</tr>
						</tbody>
					</table>
				</div>

				<aside class="bg-primary text-white rounded-2xl p-6 sm:p-7 flex flex-col">
					<h3 class="text-xl mb-2" data-i18n-key="pricing.bundles.title">Support hour bundles</h3>
					<p class="text-sm text-white/80" data-i18n-key="pricing.bundles.subtitle">
						For incidents, adjustments and improvements after launch. Only consumed time is billed.
					</p>
					<ul class="mt-4">
						{
							bundles.map((bundle) => (
								<li class="flex items-center justify-between gap-4 border-b border-white/20 py-3 text-sm">
									<span data-i18n-key={bundle.labelKey}>{bundle.label}</span>
									<span class="font-medium">{bundle.amount}</span>
								</li>
							))
						}
					</ul>
					<p class="text-sm text-white/75 mt-auto pt-5" data-i18n-key="pricing.bundles.note">
						No long-term commitment. Adjust the bundle to your actual needs.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
