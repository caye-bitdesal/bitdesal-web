---
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import PricingOffer from '../components/PricingOffer.astro';
import Layout from '../layouts/Layout.astro';
import { getProjectTotal, getServicePhases, getSupportBundleRows } from '../data/pricingPhases';
import { useI18n } from '../i18n/useI18n';

const { t, lang } = useI18n(Astro);
const phases = getServicePhases(lang);
const projectTotal = getProjectTotal(lang);
const bundles = getSupportBundleRows(lang);

const pricingFaq = [
	{ qKey: 'pricing.faq.overrun.q', aKey: 'pricing.faq.overrun.a' },
	{ qKey: 'pricing.faq.payment.q', aKey: 'pricing.faq.payment.a' },
	{ qKey: 'pricing.faq.commitment.q', aKey: 'pricing.faq.commitment.a' },
];
---

<Layout seo="pricing">
	<PricingOffer showLead />

	<nav class="sticky top-16 z-40 bg-background/95 backdrop-blur border-b border-border">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-4 py-3">
			<a href="#ia" class="text-sm font-medium text-primary hover:underline">{t('pricing.sections.ia')}</a>
			<a href="#software" class="text-sm font-medium text-foreground/70 hover:text-primary">{t('pricing.sections.software')}</a>
		</div>
	</nav>

	<section id="ia" class="scroll-mt-28 py-20 md:py-28 bg-white">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-10">{t('pricing.sections.ia')}</h2>
			<div class="space-y-8">
			<article class="rounded-2xl border border-border p-8 bg-secondary/30">
				<h3 class="text-2xl mb-2">{t('pricing.blocks.study.title')} — {t('pricing.blocks.study.price')}</h3>
				<p class="text-foreground/70 mb-4">{t('pricing.blocks.study.note')}</p>
				<p class="text-foreground/80 mb-4">{t('pricing.blocks.study.description')}</p>
				<p class="text-primary font-medium">{t('pricing.blocks.study.discount')}</p>
			</article>
			<article class="rounded-2xl border border-border p-8">
				<h3 class="text-2xl mb-2">{t('pricing.blocks.implementation.title')} — {t('pricing.blocks.implementation.price')}</h3>
				<p class="text-foreground/80">{t('pricing.blocks.implementation.description')}</p>
			</article>
			<article class="rounded-2xl border border-border p-8 bg-secondary/30">
				<h3 class="text-2xl mb-2">{t('pricing.blocks.support.title')} — {t('pricing.blocks.support.price')}</h3>
				<p class="text-foreground/80">{t('pricing.blocks.support.description')}</p>
			</article>
			</div>
		</div>
	</section>

	<section id="software" class="scroll-mt-28 py-20 md:py-28 bg-secondary">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8">{t('pricing.softwareBlock.title')}</h2>
			<ul class="space-y-4 text-lg text-foreground/80">
				<li>{t('pricing.softwareBlock.hourly')}</li>
				<li>{t('pricing.softwareBlock.bundles')}</li>
				<li>{t('pricing.softwareBlock.fixed')}</li>
			</ul>
			<p class="text-sm text-foreground/55 mt-6">{t('pricing.softwareBlock.international')}</p>
		</div>
	</section>

	<section class="py-16 md:py-20 bg-white">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<details class="group rounded-xl border border-border bg-white" id="ia-fases" open>
				<summary class="cursor-pointer list-none px-5 py-4 font-medium">{t('pricing.breakdownToggle')}</summary>
				<div class="px-5 pb-6">
					<div class="text-center max-w-2xl mx-auto mb-8 pt-4">
						<p class="text-xs tracking-[0.18em] uppercase text-primary/80 mb-3">{t('pricing.phases.eyebrow')}</p>
						<p class="text-foreground/70">{t('pricing.phases.subtitle')}</p>
					</div>
					<ol>
						{
							phases.map((phase, index) => (
								<li class="flex items-start justify-between gap-6 py-5 border-b border-border">
									<div class="flex items-start gap-4 min-w-0">
										<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm text-white">{index + 1}</span>
										<div class="min-w-0 pt-0.5">
											<h3 class="text-base">{t(phase.titleKey, phase.title)}</h3>
											<p class="text-sm text-foreground/60 mt-0.5">{t(phase.descKey, phase.description)}</p>
										</div>
									</div>
									<div class="text-right shrink-0 pt-0.5">
										<p class="text-sm">{phase.hours}</p>
										<p class="text-sm text-primary">{phase.amount}</p>
									</div>
								</li>
							))
						}
					</ol>
					<div class="mt-8 flex items-start gap-3 rounded-xl bg-[#f3f4f6] px-5 py-4 text-sm text-foreground/80">
						<p>
							<span class="font-medium text-foreground">{t('pricing.phases.coreLabel')}</span>{' '}
							{t('pricing.phases.core')}
						</p>
					</div>

					<div class="mt-10 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-6 items-stretch">
						<div class="bg-white rounded-xl overflow-hidden shadow-sm border border-black/5">
							<table class="w-full text-sm">
								<thead class="bg-[#f4f7f6] text-foreground/70">
									<tr>
										<th class="text-left font-medium px-4 py-3">{t('pricing.investment.phase')}</th>
										<th class="text-right font-medium px-4 py-3">{t('pricing.investment.hours')}</th>
										<th class="text-right font-medium px-4 py-3">{t('pricing.investment.amount')}</th>
									</tr>
								</thead>
								<tbody>
									{
										phases.map((phase, index) => (
											<tr class="border-t border-border">
												<td class="px-4 py-3">
													{index + 1}. {t(phase.shortKey, phase.short)}
												</td>
												<td class="px-4 py-3 text-right text-foreground/70">{phase.hours}</td>
												<td class="px-4 py-3 text-right text-primary">{phase.amount}</td>
											</tr>
										))
									}
									<tr class="border-t border-border font-medium">
										<td class="px-4 py-3">{t('pricing.investment.total')}</td>
										<td class="px-4 py-3 text-right">{projectTotal.hours}</td>
										<td class="px-4 py-3 text-right text-primary">{projectTotal.amount}</td>
									</tr>
								</tbody>
							</table>
						</div>
						<aside class="bg-primary text-white rounded-2xl p-6 sm:p-7 flex flex-col">
							<h3 class="text-xl mb-2">{t('pricing.bundles.title')}</h3>
							<p class="text-sm text-white/80">{t('pricing.bundles.subtitle')}</p>
							<ul class="mt-4">
								{
									bundles.map((bundle) => (
										<li class="flex items-center justify-between gap-4 border-b border-white/20 py-3 text-sm">
											<span>{t(bundle.labelKey, bundle.label)}</span>
											<span class="font-medium">{bundle.amount}</span>
										</li>
									))
								}
							</ul>
							<p class="text-sm text-white/75 mt-auto pt-5">{t('pricing.bundles.note')}</p>
						</aside>
					</div>
				</div>
			</details>
		</div>
	</section>

	<section class="py-16 md:py-20 bg-secondary">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl mb-8 text-center">{t('pricing.packages.title')}</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<article class="bg-secondary/40 rounded-xl p-6 shadow-sm border border-border">
					<h3 class="text-xl mb-2">{t('pricing.packages.express.title')}</h3>
					<p class="text-primary font-medium mb-1">{t('pricing.packages.express.price')}</p>
					<p class="text-sm text-foreground/60 mb-4">{t('pricing.packages.express.time')}</p>
					<p class="text-foreground/75 text-sm">{t('pricing.packages.express.description')}</p>
				</article>
				<article class="bg-secondary/40 rounded-xl p-6 shadow-sm border border-border">
					<h3 class="text-xl mb-2">{t('pricing.packages.custom.title')}</h3>
					<p class="text-primary font-medium mb-4">{t('pricing.packages.custom.price')}</p>
					<p class="text-foreground/75 text-sm">{t('pricing.packages.custom.description')}</p>
				</article>
				<article class="bg-secondary/40 rounded-xl p-6 shadow-sm border border-border">
					<h3 class="text-xl mb-2">{t('pricing.packages.maintenance.title')}</h3>
					<p class="text-primary font-medium mb-4">{t('pricing.packages.maintenance.price')}</p>
					<p class="text-foreground/75 text-sm">{t('pricing.packages.maintenance.description')}</p>
				</article>
			</div>
		</div>
	</section>

	<FaqSection titleKey="pricing.faq.title" items={pricingFaq} />
	<CtaSection />
</Layout>
