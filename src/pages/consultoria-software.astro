---
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostsCarousel from '../components/LinkedInPostsCarousel.astro';
import MethodologySection from '../components/MethodologySection.astro';
import Layout from '../layouts/Layout.astro';
import { BOOKING_URL } from '../data/siteConstants';
import { sitePath } from '../data/siteNav';
import { linkedInPosts } from '../data/linkedInPosts';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);

const serviceKeys = ['android', 'architecture', 'ai', 'mentoring'] as const;
---

<Layout seo="consultoria">
	<section class="page-hero bg-gradient-to-br from-primary to-primary/80 text-white py-16 md:py-24">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl md:text-5xl mb-6">{t('consultoriaPage.hero.title')}</h1>
			<p class="text-xl text-white/90 mb-8">{t('consultoriaPage.hero.subtitle')}</p>
			<a href={BOOKING_URL} class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors">
				{t('common.bookCta')}
			</a>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-lg text-foreground/80 leading-relaxed">
			<p>{t('consultoriaPageExpanded.intro.p1')}</p>
			<p>{t('consultoriaPageExpanded.intro.p2')}</p>
			<p>
				{t('consultoriaPageExpanded.androidPromo.p1')}{' '}
				<a href={sitePath('/consultoria-android', lang)} class="text-primary font-medium hover:underline">
					{t('consultoriaPageExpanded.androidPromo.linkConsulting')}
				</a>
				{' '}
				{t('consultoriaPageExpanded.androidPromo.and')}{' '}
				{
					lang === 'es' ? (
						<a href={sitePath('/auditoria-app-android', lang)} class="text-primary font-medium hover:underline">
							{t('consultoriaPageExpanded.androidPromo.linkAudit')}
						</a>
					) : (
						<span>{t('consultoriaPageExpanded.androidPromo.linkAudit')}</span>
					)
				}
				.
			</p>
			<p>{t('consultoriaPageExpanded.androidPromo.p2')}</p>
			<p>{t('consultoriaPageExpanded.body.p1')}</p>
			<p>{t('consultoriaPageExpanded.body.p2')}</p>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl text-center mb-12">{t('consultoriaPage.services.title')}</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{
					serviceKeys.map((key) => (
						<article class="rounded-xl border border-border p-8 shadow-sm bg-card">
							<h3 class="text-xl mb-3">{t(`consultoriaPage.services.${key}.title`)}</h3>
							<p class="text-foreground/75">{t(`consultoriaPage.services.${key}.description`)}</p>
							{key === 'android' && (
								<p class="mt-4">
									<a href={sitePath('/consultoria-android', lang)} class="text-primary font-medium hover:underline">
										{t('consultoriaPageExpanded.androidPromo.linkConsulting')}
									</a>
								</p>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<MethodologySection />

	<section class="py-12 md:py-16 bg-secondary">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<a
				href={`${sitePath('/casos-y-precios', lang)}#software`}
				class="inline-flex items-center gap-2 text-primary text-lg font-medium hover:gap-3 transition-all"
			>
				{t('consultoriaPage.pricing.details')}
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl md:text-4xl text-center mb-10">{t('home.blog.title')}</h2>
			<LinkedInPostsCarousel posts={linkedInPosts.slice(0, 3)} />
		</div>
	</section>

	<CtaSection variant="software" />
</Layout>
