---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostsCarousel from '../components/LinkedInPostsCarousel.astro';
import { linkedInPosts } from '../data/linkedInPosts';
---

<Layout>
	<section class="relative bg-gradient-to-br from-[#2d5f5d] to-[#1a3a38] text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
			<div class="max-w-3xl">
				<h1 class="text-4xl md:text-6xl mb-6" data-i18n-key="home.hero.title">
					Android that ships, and stays maintainable
				</h1>
				<p class="text-xl md:text-2xl text-white/90 mb-8">
					<span data-i18n-key="home.hero.subtitle">
						Senior Android engineering, AI-assisted delivery and Spec-Driven Development — 20 years across Spain,
						Switzerland and Finland.
					</span>
				</p>
				<div class="flex flex-wrap gap-4">
					<a
						href="/projects"
						class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors"
						data-i18n-key="home.hero.viewProjects"
					>
						View projects
					</a>
					<a
						href="mailto:caye@bitdesal.com"
						class="inline-flex items-center gap-2 border-2 border-white text-white px-8 py-3 rounded-lg hover:bg-white/10 transition-colors"
						data-i18n-key="home.hero.contact"
					>
						Contact
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.whyBitdesal.title">Why Bitdesal?</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.whyBitdesal.subtitle">
					Clear specs, production-quality Android, and a handover your team can keep.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">K</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.modernStack.title">Modern Stack</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.modernStack.description">
						Kotlin, Jetpack Compose and modular architecture that your team can own after handoff.
					</p>
				</div>

				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">AI</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.practicalAI.title">Practical AI</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.practicalAI.description">
						Agents for review, scaffolding and docs — faster delivery without sacrificing quality.
					</p>
				</div>

				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">1:1</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.mentorship.title">Mentorship</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.mentorship.description">
						Coaching that leaves the team stronger, not dependent on a single consultant.
					</p>
				</div>

				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">20</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.experience.title">20 Years</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.experience.description">
						Apps, SDKs and teams shipped in Spain, Switzerland and Finland.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div>
					<h2 class="text-3xl md:text-4xl mb-6" data-i18n-key="home.android.title">
						Android you can release every month
					</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="home.android.description">
						From architecture to Play Store cadence: Kotlin, Compose, tests and CI that keep crash-free rates high.
					</p>
					<ul class="space-y-3">
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.android.item1">MVVM/MVI Architecture with Clean Architecture</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.android.item2">Comprehensive testing with JUnit, Espresso and Compose Testing</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.android.item3">Automated CI/CD with GitHub Actions</span>
						</li>
					</ul>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<div class="aspect-[4/3] rounded-lg flex items-center justify-center bg-white">
						<img
							src="/logos_android.png"
							alt="Android technology logos"
							class="max-h-full max-w-full object-contain"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div class="order-2 lg:order-1">
					<div class="bg-secondary rounded-lg p-8 shadow-lg">
						<div class="aspect-[4/3] rounded-lg flex items-center justify-center bg-white">
							<img
								src="/logos_ai.png"
								alt="AI technology logos"
								class="max-h-full max-w-full object-contain"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</div>
				</div>
				<div class="order-1 lg:order-2">
					<h2 class="text-3xl md:text-4xl mb-6" data-i18n-key="home.ai.title">
						AI that shortens the path to a spec
					</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="home.ai.description">
						Review, scaffolding and documentation agents wired into a spec-driven workflow — not vibe coding.
					</p>
					<ul class="space-y-3">
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.ai.item1">Conversational agents with Claude and Gemini</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.ai.item2">AI assisted designs</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.ai.item3">Process automation with AI</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.howIWork.title">How I work</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.howIWork.subtitle">
					Specs first, quality built in, fully remote.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] xl:grid-cols-[1fr_300px] gap-10 lg:gap-12 items-start mb-16">
				<div class="space-y-10 min-w-0">
					<div>
						<h3 class="text-2xl mb-3" data-i18n-key="methodology.specDriven.title">Spec-Driven Development</h3>
						<p class="text-base text-foreground/80 mb-4" data-i18n-key="methodology.specDriven.description">
							We start every project with clear, detailed specifications.
						</p>
						<div class="space-y-3">
							<div class="flex items-start gap-3">
								<div class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h4 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.specDriven.requirements.title">
										Crystal Clear Requirements
									</h4>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.specDriven.requirements.description">
										We document every feature and acceptance criteria.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h4 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.specDriven.noSurprises.title">
										No Surprises
									</h4>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.specDriven.noSurprises.description">
										You know exactly what you'll receive.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div class="w-5 h-5 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
									<span class="text-white text-xs">✓</span>
								</div>
								<div>
									<h4 class="text-sm font-medium mb-0.5" data-i18n-key="methodology.specDriven.testing.title">
										Foundation for Testing
									</h4>
									<p class="text-sm text-foreground/70" data-i18n-key="methodology.specDriven.testing.description">
										Specs become automated test cases.
									</p>
								</div>
							</div>
						</div>
					</div>

					<div>
						<h3 class="text-2xl mb-3" data-i18n-key="methodology.quality.title">Technical Quality</h3>
						<p class="text-base text-foreground/80" data-i18n-key="methodology.quality.description">
							We make no compromises on quality.
						</p>
					</div>

					<div>
						<h3 class="text-2xl mb-3" data-i18n-key="methodology.remoteFirst.title">Remote-First</h3>
						<p class="text-base text-foreground/80" data-i18n-key="methodology.remoteFirst.description">
							We work fully remotely with asynchronous methodologies.
						</p>
					</div>
				</div>

				<aside class="w-full max-w-[260px] mx-auto lg:mx-0 lg:max-w-none shrink-0">
					<button
						type="button"
						id="sdd-open"
						class="w-full bg-white rounded-lg p-3 cursor-zoom-in transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
						aria-label="View diagram enlarged"
					>
						<img
							data-sdd-lang="en"
							src="/bitdesal_sdd_en.svg"
							alt="Spec-Driven Development diagram (English)"
							class="w-full h-auto rounded-md pointer-events-none"
							width="680"
							height="900"
							loading="lazy"
							decoding="async"
						/>
						<img
							data-sdd-lang="es"
							src="/bitdesal_sdd_es.svg"
							alt="Diagrama de Spec-Driven Development (Español)"
							class="w-full h-auto rounded-md hidden pointer-events-none"
							width="680"
							height="900"
							loading="lazy"
							decoding="async"
						/>
						<img
							data-sdd-lang="fi"
							src="/bitdesal_sdd_fi.svg"
							alt="Spec-Driven Development -kaavio (Suomi)"
							class="w-full h-auto rounded-md hidden pointer-events-none"
							width="680"
							height="900"
							loading="lazy"
							decoding="async"
						/>
					</button>
				</aside>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>1</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.discovery.title">Discovery</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.discovery.description">
						We understand your goals, requirements and constraints.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>2</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.specification.title">Specification</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.specification.description">
						We create detailed specs and acceptance criteria.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>3</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.development.title">Development</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.development.description">
						Iterative development with regular demos.
					</p>
				</div>
				<div class="bg-white rounded-lg p-6">
					<div class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center mb-4">
						<span>4</span>
					</div>
					<h3 class="mb-2" data-i18n-key="methodology.process.delivery.title">Delivery</h3>
					<p class="text-foreground/70" data-i18n-key="methodology.process.delivery.description">
						Delivery with complete documentation and handoff.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.projects.title">Projects</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.projects.subtitle">
					Highlights from our client and product work
				</p>
			</div>

			<div class="max-w-3xl mx-auto mb-10">
				<a
					href="/projects/kivra"
					class="group block bg-secondary rounded-xl p-8 md:p-10 shadow-sm border border-border hover:border-primary hover:shadow-md transition-all text-left"
				>
					<div class="flex items-start gap-6 mb-8">
						<img
							src="/kivra-app-icon.png"
							alt="Kivra Finland"
							width="96"
							height="96"
							class="w-24 h-24 rounded-2xl shadow-lg shrink-0"
							loading="lazy"
							decoding="async"
						/>
						<div class="min-w-0 pt-1">
							<h3
								class="text-3xl md:text-4xl mb-2 group-hover:text-primary transition-colors"
								data-i18n-key="projects.kivra.name"
							>
								Kivra Finland
							</h3>
							<p class="text-foreground/60">
								<span data-i18n-key="projects.kivra.tag">Android · Productivity</span>
								<span aria-hidden="true"> · </span>
								<span data-i18n-key="projects.kivra.updated">2026</span>
							</p>
						</div>
					</div>
					<p class="text-lg text-foreground/80 leading-relaxed mb-8" data-i18n-key="projects.kivra.description">
						Digital mail app used by hundreds of thousands in Finland to receive invoices, letters, tickets and
						official documents securely.
					</p>
					<span class="inline-flex items-center gap-2 text-primary text-lg group-hover:gap-3 transition-all">
						<span data-i18n-key="projects.viewProject">View project</span>
						<span aria-hidden="true">→</span>
					</span>
				</a>
			</div>

			<div class="text-center">
				<a href="/projects" class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all">
					<span data-i18n-key="home.projects.viewAll">View all projects</span>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.blog.title">Blog</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.blog.subtitle">
					Latest articles from Bitdesal on LinkedIn
				</p>
			</div>

			<LinkedInPostsCarousel posts={linkedInPosts} />

			<div class="text-center mt-10">
				<a
					href="/blog"
					class="inline-flex items-center gap-2 text-primary text-lg hover:gap-3 transition-all"
				>
					<span data-i18n-key="home.blog.viewAll">View all articles</span>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<CtaSection />

	<div
		id="sdd-modal"
		class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-8"
		role="dialog"
		aria-modal="true"
		aria-labelledby="sdd-modal-title"
	>
		<div class="absolute inset-0 bg-black/70" data-sdd-close></div>
		<div class="relative z-10 w-full max-w-3xl max-h-[90vh] flex flex-col">
			<p id="sdd-modal-title" class="sr-only">Spec-Driven Development diagram</p>
			<button
				type="button"
				data-sdd-close
				class="absolute -top-2 -right-2 sm:top-0 sm:right-0 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white text-foreground shadow-lg hover:bg-white/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
				aria-label="Close"
			>
				<span class="text-2xl leading-none" aria-hidden="true">×</span>
			</button>
			<div class="overflow-auto rounded-lg bg-secondary p-4 sm:p-6">
				<img id="sdd-modal-img" src="" alt="" class="w-full h-auto" />
			</div>
		</div>
	</div>
</Layout>

<script>
	function getActiveSddImg() {
		return document.querySelector('[data-sdd-lang]:not(.hidden)');
	}

	function applySddLang(lang) {
		document.querySelectorAll('[data-sdd-lang]').forEach((img) => {
			const isActive = img.getAttribute('data-sdd-lang') === lang;
			img.classList.toggle('hidden', !isActive);
		});

		const modal = document.getElementById('sdd-modal');
		const modalImg = document.getElementById('sdd-modal-img');
		if (modal && !modal.classList.contains('hidden') && modalImg) {
			const active = getActiveSddImg();
			if (active) {
				modalImg.src = active.src;
				modalImg.alt = active.alt;
			}
		}
	}

	function openSddModal() {
		const modal = document.getElementById('sdd-modal');
		const modalImg = document.getElementById('sdd-modal-img');
		const active = getActiveSddImg();
		if (!modal || !modalImg || !active) return;

		modalImg.src = active.src;
		modalImg.alt = active.alt;
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.style.overflow = 'hidden';
	}

	function closeSddModal() {
		const modal = document.getElementById('sdd-modal');
		if (!modal) return;

		modal.classList.add('hidden');
		modal.classList.remove('flex');
		document.body.style.overflow = '';
	}

	const openBtn = document.getElementById('sdd-open');
	openBtn?.addEventListener('click', openSddModal);

	document.querySelectorAll('[data-sdd-close]').forEach((el) => {
		el.addEventListener('click', closeSddModal);
	});

	document.addEventListener('keydown', (e) => {
		const modal = document.getElementById('sdd-modal');
		if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
			closeSddModal();
		}
	});

	applySddLang(window.bitdesalI18n?.getLanguage?.() || 'en');

	window.addEventListener('bitdesal:language', (e) => {
		const lang = e?.detail?.lang;
		if (lang) applySddLang(lang);
	});
</script>
