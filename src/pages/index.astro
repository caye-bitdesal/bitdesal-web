---
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostsCarousel from '../components/LinkedInPostsCarousel.astro';
import StatsStrip from '../components/StatsStrip.astro';
import Layout from '../layouts/Layout.astro';
import { BOOKING_URL, SHOW_CLIENT_LOGOS, SHOW_TESTIMONIAL } from '../data/siteConstants';
import { projectCards } from '../data/projectCards';
import { sitePath } from '../data/siteNav';
import { linkedInPosts } from '../data/linkedInPosts';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);

const whyCards = [
	{ icon: 'tag', titleKey: 'home.whyBitdesal.fixedPrice.title', descKey: 'home.whyBitdesal.fixedPrice.description' },
	{ icon: 'user', titleKey: 'home.whyBitdesal.direct.title', descKey: 'home.whyBitdesal.direct.description' },
	{ icon: 'unlock', titleKey: 'home.whyBitdesal.independence.title', descKey: 'home.whyBitdesal.independence.description' },
	{ icon: 'spark', titleKey: 'home.whyBitdesal.ai.title', descKey: 'home.whyBitdesal.ai.description' },
] as const;
---

<Layout seo="home">
	<section class="relative overflow-hidden text-white">
		<img
			src="/hero-home.jpg"
			alt="TODO(caye): foto — sustituir por foto profesional o captura de automatización"
			class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
			width="1024"
			height="480"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-[#1a3a38]/65 via-[#1a3a38]/45 to-[#1a3a38]/10" aria-hidden="true"></div>
		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
			<div class="max-w-3xl">
				<h1 class="text-4xl md:text-6xl mb-6">{t('home.hero.title')}</h1>
				<p class="text-xl md:text-2xl text-white/90 mb-8">{t('home.hero.subtitle')}</p>
				<div class="flex flex-wrap gap-4">
					<a
						href={BOOKING_URL}
						class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors"
					>
						{t('common.bookCta', 'Agenda 30 min gratis')}
					</a>
					<a
						href="#servicios"
						class="inline-flex items-center gap-2 border-2 border-white text-white px-8 py-3 rounded-lg hover:bg-white/10 transition-colors"
					>
						{t('common.seeHowIWork', 'Ver qué hacemos')}
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="servicios" class="py-16 md:py-20 bg-white scroll-mt-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				<a
					href={sitePath('/consultoria-ia', lang)}
					class="group flex flex-col rounded-2xl border-2 border-border bg-secondary/40 p-8 md:p-10 hover:border-primary hover:shadow-lg transition-all"
				>
					<h2 class="text-2xl md:text-3xl mb-4 group-hover:text-primary transition-colors">
						{t('home.serviceCards.ia.title')}
					</h2>
					<p class="text-foreground/75 leading-relaxed flex-1 mb-6">{t('home.serviceCards.ia.description')}</p>
					<p class="text-primary font-semibold mb-4">{t('home.serviceCards.ia.priceHint')}</p>
					<span class="inline-flex items-center gap-2 text-primary font-medium group-hover:gap-3 transition-all">
						{t('home.serviceCards.ia.cta')}
						<span aria-hidden="true">→</span>
					</span>
				</a>
				<a
					href={sitePath('/consultoria-software', lang)}
					class="group flex flex-col rounded-2xl border-2 border-border bg-secondary/40 p-8 md:p-10 hover:border-primary hover:shadow-lg transition-all"
				>
					<h2 class="text-2xl md:text-3xl mb-4 group-hover:text-primary transition-colors">
						{t('home.serviceCards.software.title')}
					</h2>
					<p class="text-foreground/75 leading-relaxed flex-1 mb-6">{t('home.serviceCards.software.description')}</p>
					<p class="text-primary font-semibold mb-4">{t('home.serviceCards.software.priceHint')}</p>
					<span class="inline-flex items-center gap-2 text-primary font-medium group-hover:gap-3 transition-all">
						{t('home.serviceCards.software.cta')}
						<span aria-hidden="true">→</span>
					</span>
				</a>
			</div>
		</div>
	</section>

	<StatsStrip />

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl mb-4">{t('home.whyBitdesal.title')}</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto">{t('home.whyBitdesal.subtitle')}</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{
					whyCards.map((card) => (
						<div class="text-center">
							<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4 text-primary">
								{card.icon === 'tag' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7" aria-hidden="true">
										<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
										<circle cx="7" cy="7" r="1.5" fill="currentColor" stroke="none" />
									</svg>
								)}
								{card.icon === 'user' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7" aria-hidden="true">
										<circle cx="12" cy="8" r="4" />
										<path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6" stroke-linecap="round" />
									</svg>
								)}
								{card.icon === 'unlock' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7" aria-hidden="true">
										<rect x="5" y="11" width="14" height="10" rx="2" />
										<path d="M8 11V8a4 4 0 0 1 8 0v3" stroke-linecap="round" />
									</svg>
								)}
								{card.icon === 'spark' && (
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7" aria-hidden="true">
										<path d="M12 3l1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3z" stroke-linejoin="round" />
									</svg>
								)}
							</div>
							<h3 class="mb-2">{t(card.titleKey)}</h3>
							<p class="text-foreground/70">{t(card.descKey)}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
				<div class="order-2 lg:order-1">
					<h2 class="text-3xl md:text-4xl mb-6">{t('home.behind.title')}</h2>
					<p class="text-lg text-foreground/80 leading-relaxed mb-8">{t('home.behind.text')}</p>
					<a href={sitePath('/nosotros', lang)} class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all">
						{t('common.meetUs', 'Conócenos')}
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="order-1 lg:order-2 flex justify-center">
					<img
						src="/caye-ruiz-portrait.jpg"
						alt="Caye Ruiz, fundador de Bitdesal"
						class="w-full max-w-sm rounded-xl object-cover aspect-[3/4] shadow-lg"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</section>

	{
		SHOW_CLIENT_LOGOS && (
			<section class="py-12 bg-secondary">
				<div class="max-w-7xl mx-auto px-4 text-center">
					<p class="text-sm uppercase tracking-widest text-foreground/60 mb-6">{t('home.logos.title')}</p>
					<!-- TODO(caye): permiso logos -->
				</div>
			</section>
		)
	}

	{
		SHOW_TESTIMONIAL && (
			<section class="py-12 bg-white">
				<!-- TODO(caye): testimonio -->
			</section>
		)
	}

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4">{t('home.projects.title')}</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto">{t('home.projects.subtitle')}</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto mb-10">
				{
					projectCards.map((project) => (
						<a
							href={sitePath(project.href, lang)}
							class="group block bg-white rounded-xl p-8 shadow-sm border border-border hover:border-primary hover:shadow-md transition-all text-left"
						>
							<div class="flex items-start gap-6 mb-6">
								<img src={project.iconSrc} alt={project.iconAlt} width="80" height="80" class="w-20 h-20 rounded-2xl shadow-lg shrink-0" loading="lazy" />
								<div class="min-w-0 pt-1">
									<h3 class="text-2xl mb-2 group-hover:text-primary transition-colors">{t(project.nameKey)}</h3>
									<p class="text-foreground/60 text-sm">
										{t(project.tagKey)} · {t(project.updatedKey)}
									</p>
								</div>
							</div>
							<p class="text-foreground/80 leading-relaxed">{t(project.descriptionKey)}</p>
						</a>
					))
				}
			</div>

			<div class="text-center">
				<a href={sitePath('/projects', lang)} class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all">
					{t('home.projects.viewAll')}
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4">{t('home.blog.title')}</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto">{t('home.blog.subtitle')}</p>
			</div>
			<LinkedInPostsCarousel posts={linkedInPosts.slice(0, 3)} />
			<div class="text-center mt-10">
				<a href={sitePath('/blog', lang)} class="inline-flex items-center gap-2 text-primary text-lg hover:gap-3 transition-all">
					{t('home.blog.viewAll')}
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<CtaSection />
</Layout>
