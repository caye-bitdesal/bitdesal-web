---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import LinkedInPostsCarousel from '../components/LinkedInPostsCarousel.astro';

const linkedInPosts = [
	{
		url: 'https://www.linkedin.com/pulse/guide-how-implement-cicd-android-using-github-actions-bitdesal-murze/',
		titleKey: 'home.blog.posts.cicd.title',
		excerptKey: 'home.blog.posts.cicd.excerpt',
		dateKey: 'home.blog.posts.cicd.date',
	},
	{
		url: 'https://www.linkedin.com/pulse/insomnia-ai-agents-8-hour-simple-feature-bitdesal-ytkke/',
		titleKey: 'home.blog.posts.insomnia.title',
		excerptKey: 'home.blog.posts.insomnia.excerpt',
		dateKey: 'home.blog.posts.insomnia.date',
	},
	{
		url: 'https://www.linkedin.com/pulse/can-you-afford-your-ai-assisted-development-bitdesal-ubtpe',
		titleKey: 'home.blog.posts.afford.title',
		excerptKey: 'home.blog.posts.afford.excerpt',
		dateKey: 'home.blog.posts.afford.date',
		image: '/blog/can-you-afford-ai-assisted-development.png',
		imageAltKey: 'home.blog.posts.afford.imageAlt',
	},
	{
		url: 'https://www.linkedin.com/pulse/beyond-vibe-coding-manifesto-sustainable-ai-engineering-bitdesal-x5bxe',
		titleKey: 'home.blog.posts.manifesto.title',
		excerptKey: 'home.blog.posts.manifesto.excerpt',
		dateKey: 'home.blog.posts.manifesto.date',
		image: '/blog/beyond-vibe-coding-manifesto.png',
		imageAltKey: 'home.blog.posts.manifesto.imageAlt',
	},
];
---

<Layout>
	<section class="relative bg-gradient-to-br from-[#2d5f5d] to-[#1a3a38] text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
			<div class="max-w-3xl">
				<h1 class="text-4xl md:text-6xl mb-6" data-i18n-key="home.hero.title">
					Android Development, done right
				</h1>
				<p class="text-xl md:text-2xl text-white/90 mb-8">
					<span data-i18n-key="home.hero.subtitle">
						Modern Android development, AI solutions and strategic consulting with 20 years of international
						experience
					</span>
				</p>
				<div class="flex flex-wrap gap-4">
					<a
						href="/methodology"
						class="inline-flex items-center gap-2 bg-white text-primary px-8 py-3 rounded-lg hover:bg-white/90 transition-colors"
						data-i18n-key="home.hero.viewServices"
					>
						View methodology
					</a>
					<a
						href="/contact"
						class="inline-flex items-center gap-2 border-2 border-white text-white px-8 py-3 rounded-lg hover:bg-white/10 transition-colors"
						data-i18n-key="home.hero.contact"
					>
						Contact
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.whyBitdesal.title">Why Bitdesal?</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.whyBitdesal.subtitle">
					We combine world-class technical expertise with internationally proven methodologies
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">K</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.modernStack.title">Modern Stack</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.modernStack.description">
						Kotlin, Jetpack Compose, modular architecture and the latest Android technologies
					</p>
				</div>

				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">AI</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.practicalAI.title">Practical AI</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.practicalAI.description">
						Intelligent agents and automations that generate real value for your business
					</p>
				</div>

				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">1:1</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.mentorship.title">Mentorship</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.mentorship.description">
						Personalized training to elevate your technical team's capabilities
					</p>
				</div>

				<div class="text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-secondary rounded-lg mb-4">
						<span class="text-primary text-2xl font-semibold">20</span>
					</div>
					<h3 class="mb-2" data-i18n-key="home.whyBitdesal.experience.title">20 Years</h3>
					<p class="text-foreground/70" data-i18n-key="home.whyBitdesal.experience.description">
						International experience in Spain, Switzerland and Finland with high-impact projects
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div>
					<h2 class="text-3xl md:text-4xl mb-6" data-i18n-key="home.android.title">
						Next-Generation Android Development
					</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="home.android.description">
						Specialists in Kotlin and Jetpack Compose with scalable modular architecture.
					</p>
					<ul class="space-y-3 mb-8">
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.android.item1">MVVM/MVI Architecture with Clean Architecture</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.android.item2">Comprehensive testing with JUnit, Espresso and Compose Testing</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.android.item3">Automated CI/CD with GitHub Actions</span>
						</li>
					</ul>
					<a href="/methodology" class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all">
						<span data-i18n-key="home.android.learnMore">Learn more</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="bg-white rounded-lg p-8 shadow-lg">
					<div class="aspect-[4/3] rounded-lg flex items-center justify-center bg-white">
						<img
							src="/logos_android.png"
							alt="Android technology logos"
							class="max-h-full max-w-full object-contain"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div class="order-2 lg:order-1">
					<div class="bg-secondary rounded-lg p-8 shadow-lg">
						<div class="aspect-[4/3] rounded-lg flex items-center justify-center bg-white">
							<img
								src="/logos_ai.png"
								alt="Android technology logos"
								class="max-h-full max-w-full object-contain"
								loading="lazy"
								decoding="async"
							/>
						</div>
					</div>
				</div>
				<div class="order-1 lg:order-2">
					<h2 class="text-3xl md:text-4xl mb-6" data-i18n-key="home.ai.title">
						Artificial Intelligence that Works
					</h2>
					<p class="text-lg text-foreground/80 mb-6" data-i18n-key="home.ai.description">
						We develop AI agents and intelligent automations that solve real problems and generate measurable ROI.
					</p>
					<ul class="space-y-3 mb-8">
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.ai.item1">Conversational agents with Claude and Gemini</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.ai.item2">AI assisted designs</span>
						</li>
						<li class="flex items-start gap-3">
							<div
								class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
							>
								<span class="text-white text-sm">✓</span>
							</div>
							<span data-i18n-key="home.ai.item3">Process automation with AI</span>
						</li>
					</ul>
					<a href="/methodology" class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all">
						<span data-i18n-key="home.ai.explore">Explore AI solutions</span>
						<span aria-hidden="true">→</span>
					</a>
				
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-secondary">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.projects.title">Projects</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.projects.subtitle">
					Highlights from our client and product work
				</p>
			</div>

			<div class="max-w-3xl mx-auto mb-10">
				<a
					href="/projects/kivra"
					class="group block bg-white rounded-xl p-8 md:p-10 shadow-sm border border-border hover:border-primary hover:shadow-md transition-all text-left"
				>
					<div class="flex items-start gap-6 mb-8">
						<img
							src="/kivra-app-icon.png"
							alt="Kivra Finland"
							width="96"
							height="96"
							class="w-24 h-24 rounded-2xl shadow-lg shrink-0"
							loading="lazy"
							decoding="async"
						/>
						<div class="min-w-0 pt-1">
							<h3
								class="text-3xl md:text-4xl mb-2 group-hover:text-primary transition-colors"
								data-i18n-key="projects.kivra.name"
							>
								Kivra Finland
							</h3>
							<p class="text-foreground/60">
								<span data-i18n-key="projects.kivra.tag">Android · Productivity</span>
								<span aria-hidden="true"> · </span>
								<span data-i18n-key="projects.kivra.updated">2026</span>
							</p>
						</div>
					</div>
					<p class="text-lg text-foreground/80 leading-relaxed mb-8" data-i18n-key="projects.kivra.description">
						Digital mail app used by hundreds of thousands in Finland to receive invoices, letters, tickets and
						official documents securely.
					</p>
					<span class="inline-flex items-center gap-2 text-primary text-lg group-hover:gap-3 transition-all">
						<span data-i18n-key="projects.viewProject">View project</span>
						<span aria-hidden="true">→</span>
					</span>
				</a>
			</div>

			<div class="text-center">
				<a href="/projects" class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all">
					<span data-i18n-key="home.projects.viewAll">View all projects</span>
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl mb-4" data-i18n-key="home.blog.title">Blog</h2>
				<p class="text-lg text-foreground/70 max-w-2xl mx-auto" data-i18n-key="home.blog.subtitle">
					Latest articles from Bitdesal on LinkedIn
				</p>
			</div>

			<LinkedInPostsCarousel posts={linkedInPosts} />
		</div>
	</section>

	<CtaSection />
</Layout>
