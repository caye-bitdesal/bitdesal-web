---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import PricingOffer from '../components/PricingOffer.astro';
import PricingPageContent from '../components/PricingPageContent.astro';
import ProjectListSection from '../components/ProjectListSection.astro';
import { useI18n } from '../i18n/useI18n';

const { t } = useI18n(Astro);
---

<Layout seo="workAndPricing">
	<PricingOffer showLead />

	<nav
		class="border-b border-border bg-white py-4"
		aria-label={t('workAndPricing.title')}
	>
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap justify-center gap-3">
			<a
				href="#precios"
				class="inline-flex items-center rounded-full border border-border bg-secondary/50 px-5 py-2 text-sm font-medium text-foreground hover:border-primary hover:bg-secondary transition-colors"
			>
				{t('workAndPricing.tabPricing')}
			</a>
			<a
				href="#casos"
				class="inline-flex items-center rounded-full border border-border bg-secondary/50 px-5 py-2 text-sm font-medium text-foreground hover:border-primary hover:bg-secondary transition-colors"
			>
				{t('workAndPricing.tabCases')}
			</a>
		</div>
	</nav>

	<section id="precios" class="scroll-mt-20 bg-white">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 md:pt-14 pb-2">
			<h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-foreground">
				{t('workAndPricing.tabPricing')}
			</h2>
		</div>
		<PricingPageContent hideHero />
	</section>

	<section id="casos" class="scroll-mt-28 border-t border-border bg-white pt-10 md:pt-14 pb-16 md:pb-24">
		<ProjectListSection showSectionTitle />
	</section>

	<CtaSection />
</Layout>
