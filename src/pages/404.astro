---
import CtaSection from '../components/CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../data/siteNav';
import { useI18n } from '../i18n/useI18n';

const { lang, t } = useI18n(Astro);
---

<Layout seo="notFound">
	<div class="min-h-[60vh] flex items-center justify-center bg-white">
		<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<div class="mb-8">
				<div class="text-8xl md:text-9xl text-primary/20 mb-4">{t('notFound.code')}</div>
				<h1 class="text-3xl md:text-4xl mb-4">{t('notFound.title')}</h1>
				<p class="text-lg text-foreground/70 mb-8">{t('notFound.description')}</p>
			</div>

			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href={sitePath('/', lang)} class="inline-flex items-center justify-center gap-2 bg-primary text-white px-8 py-3 rounded-lg hover:bg-primary/90 transition-colors">
					{t('notFound.home')}
				</a>
				<button type="button" id="go-back" class="inline-flex items-center justify-center gap-2 border-2 border-primary text-primary px-8 py-3 rounded-lg hover:bg-primary/5 transition-colors">
					{t('notFound.back')}
				</button>
			</div>
		</div>
	</div>
	<CtaSection />
</Layout>

<script>
	document.getElementById('go-back')?.addEventListener('click', () => window.history.back());
</script>
