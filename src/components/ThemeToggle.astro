---
import { useI18n } from '../i18n/useI18n';

const { t } = useI18n(Astro);
---

<button
	type="button"
	class="theme-toggle shrink-0 inline-flex h-9 w-9 items-center justify-center rounded-lg text-foreground/70 hover:text-primary transition-colors dark:text-[#d4d4d8] dark:hover:text-[#5da399]"
	aria-label={t('theme.switchToDark')}
	data-theme-toggle
>
	<svg class="theme-icon-sun h-5 w-5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
	</svg>
	<svg class="theme-icon-moon h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linejoin="round" />
	</svg>
</button>
