---
import type { LinkedInPost } from '../data/linkedInPosts';
import { useI18n } from '../i18n/useI18n';

interface Props {
	post: LinkedInPost;
	class?: string;
}

const { post, class: className } = Astro.props;
const { t } = useI18n(Astro);
---

<article class:list={['flex flex-col h-full', className]}>
	<div class="group flex flex-col h-full bg-white border border-border rounded-xl overflow-hidden hover:border-primary hover:shadow-md transition-all">
		<a href={post.url} target="_blank" rel="noopener noreferrer" class="block">
			{
				post.image ? (
					<div class="aspect-[16/9] overflow-hidden bg-foreground/5">
						<img
							src={post.image}
							alt={post.imageAltKey ? t(post.imageAltKey) : ''}
							class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
							loading="lazy"
							decoding="async"
						/>
					</div>
				) : (
					<div class="aspect-[16/9] bg-gradient-to-br from-primary to-primary/80 flex items-center justify-center p-6">
						<span class="text-white/90 text-sm font-medium tracking-wide uppercase">LinkedIn</span>
					</div>
				)
			}
		</a>
		<div class="p-6 flex flex-col flex-1">
			<p class="text-sm text-foreground/60 mb-2">{t(post.dateKey)}</p>
			<h3 class="text-xl mb-3 leading-snug">
				<a href={post.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
					{t(post.titleKey)}
				</a>
			</h3>
			<p class="text-foreground/70 text-sm leading-relaxed flex-1 mb-4">{t(post.excerptKey)}</p>
			<div class="flex flex-col gap-2">
				<a href={post.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary text-sm hover:gap-3 transition-all w-fit">
					{t('home.blog.readOnLinkedIn')}
					<span aria-hidden="true">↗</span>
				</a>
				{
					post.mediumUrl && (
						<a href={post.mediumUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary text-sm hover:gap-3 transition-all w-fit">
							{t('home.blog.readOnMedium')}
							<span aria-hidden="true">↗</span>
						</a>
					)
				}
			</div>
		</div>
	</div>
</article>
