---
const navLinks = [
	{ href: '/', labelKey: 'nav.home', fallback: 'Home' },
	{ href: '/about', labelKey: 'nav.about', fallback: 'About' },
	{ href: '/projects', labelKey: 'nav.projects', fallback: 'Projects' },
	{ href: '/blog', labelKey: 'nav.blog', fallback: 'Blog' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

/** @param {string} href */
function isNavActive(href: string) {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
}

const languages = [
	{ code: 'en', label: 'EN' },
	{ code: 'es', label: 'ES' },
	{ code: 'fi', label: 'FI' },
] as const;
---

<header class="sticky top-0 z-50 bg-white border-b border-border">
	<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Primary">
		<div class="flex justify-between items-center h-16">
			<a href="/" class="flex items-center gap-3">
				<span class="text-xl text-primary">Bitdesal</span>
			</a>

			<div class="hidden md:flex items-center gap-8">
				{navLinks.map((link) => (
					<a
						href={link.href}
						class:list={[
							'transition-colors hover:text-primary',
							isNavActive(link.href) ? 'text-primary' : 'text-foreground/70',
						]}
						aria-current={isNavActive(link.href) ? 'page' : undefined}
						data-i18n-key={link.labelKey}
					>
						{link.fallback}
					</a>
				))}

				<a
					href="mailto:caye@bitdesal.com"
					class="contact-btn inline-flex items-center justify-center bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary/90 transition-colors text-sm"
					data-i18n-key="nav.contact"
				>
					Contact
				</a>

				<div class="relative" data-lang-dropdown>
					<button
						type="button"
						class="lang-trigger inline-flex items-center gap-1 text-primary transition-colors hover:text-primary/80"
						data-lang-trigger
						aria-expanded="false"
						aria-haspopup="listbox"
						aria-controls="lang-menu-desktop"
					>
						<span data-lang-label>EN</span>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
							<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
						</svg>
						<span class="sr-only" data-i18n-key="nav.language">Language</span>
					</button>
					<ul
						id="lang-menu-desktop"
						class="absolute right-0 mt-2 min-w-[4.5rem] rounded-lg border border-border bg-white py-1 shadow-lg hidden"
						data-lang-menu
						role="listbox"
					>
						{languages.map((lang) => (
							<li>
								<a
									href={`?lang=${lang.code}`}
									data-lang={lang.code}
									class="block px-3 py-1.5 text-sm text-foreground/70 hover:bg-secondary hover:text-primary transition-colors"
									role="option"
								>
									{lang.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>

			<button
				id="mobile-menu-button"
				class="md:hidden p-2"
				type="button"
				aria-controls="mobile-menu"
				aria-expanded="false"
			>
				<span class="sr-only">Open menu</span>
				<svg
					id="icon-menu"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-6 w-6"
				>
					<line x1="3" x2="21" y1="6" y2="6"></line>
					<line x1="3" x2="21" y1="12" y2="12"></line>
					<line x1="3" x2="21" y1="18" y2="18"></line>
				</svg>
				<svg
					id="icon-close"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-6 w-6 hidden"
				>
					<path d="M18 6 6 18"></path>
					<path d="m6 6 12 12"></path>
				</svg>
			</button>
		</div>

		<div id="mobile-menu" class="md:hidden py-4 border-t border-border hidden">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						'block py-2 transition-colors hover:text-primary',
						isNavActive(link.href) ? 'text-primary' : 'text-foreground/70',
					]}
					aria-current={isNavActive(link.href) ? 'page' : undefined}
					data-i18n-key={link.labelKey}
				>
					{link.fallback}
				</a>
			))}

			<a
				href="mailto:caye@bitdesal.com"
				class="contact-btn inline-flex items-center justify-center bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary/90 transition-colors text-sm mt-3"
				data-i18n-key="nav.contact"
			>
				Contact
			</a>

			<div class="relative mt-4 pt-4 border-t border-border" data-lang-dropdown>
				<button
					type="button"
					class="lang-trigger inline-flex items-center gap-1 text-primary transition-colors hover:text-primary/80"
					data-lang-trigger
					aria-expanded="false"
					aria-haspopup="listbox"
					aria-controls="lang-menu-mobile"
				>
					<span data-lang-label>EN</span>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
						<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
					</svg>
					<span class="sr-only" data-i18n-key="nav.language">Language</span>
				</button>
				<ul
					id="lang-menu-mobile"
					class="mt-2 min-w-[4.5rem] rounded-lg border border-border bg-white py-1 shadow-lg hidden"
					data-lang-menu
					role="listbox"
				>
					{languages.map((lang) => (
						<li>
							<a
								href={`?lang=${lang.code}`}
								data-lang={lang.code}
								class="block px-3 py-1.5 text-sm text-foreground/70 hover:bg-secondary hover:text-primary transition-colors"
								role="option"
							>
								{lang.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</nav>
</header>

<script>
	const button = document.getElementById('mobile-menu-button');
	const menu = document.getElementById('mobile-menu');
	const iconMenu = document.getElementById('icon-menu');
	const iconClose = document.getElementById('icon-close');

	if (button && menu && iconMenu && iconClose) {
		button.addEventListener('click', () => {
			const isOpen = !menu.classList.contains('hidden');
			menu.classList.toggle('hidden', isOpen);
			iconMenu.classList.toggle('hidden', !isOpen);
			iconClose.classList.toggle('hidden', isOpen);
			button.setAttribute('aria-expanded', String(!isOpen));
		});
	}

	const langLabels: Record<string, string> = { en: 'EN', es: 'ES', fi: 'FI' };

	function closeLangMenus(except?: HTMLElement) {
		document.querySelectorAll('[data-lang-dropdown]').forEach((dropdown) => {
			if (except && dropdown === except) return;
			const trigger = dropdown.querySelector('[data-lang-trigger]');
			const panel = dropdown.querySelector('[data-lang-menu]');
			panel?.classList.add('hidden');
			trigger?.setAttribute('aria-expanded', 'false');
		});
	}

	function applyLangDropdown(lang: string) {
		document.querySelectorAll('[data-lang-label]').forEach((el) => {
			el.textContent = langLabels[lang] ?? lang.toUpperCase();
		});
		document.querySelectorAll('[data-lang]').forEach((el) => {
			const isCurrent = el.getAttribute('data-lang') === lang;
			const item = el.closest('li');
			if (item) item.classList.toggle('hidden', isCurrent);
			el.setAttribute('aria-selected', String(isCurrent));
		});
	}

	document.querySelectorAll('[data-lang-dropdown]').forEach((dropdown) => {
		const trigger = dropdown.querySelector('[data-lang-trigger]');
		const panel = dropdown.querySelector('[data-lang-menu]');
		if (!trigger || !panel) return;

		trigger.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = !panel.classList.contains('hidden');
			closeLangMenus(isOpen ? undefined : dropdown);
			panel.classList.toggle('hidden', isOpen);
			trigger.setAttribute('aria-expanded', String(!isOpen));
		});
	});

	document.addEventListener('click', () => closeLangMenus());

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeLangMenus();
	});

	const langLinks = document.querySelectorAll('[data-lang]');
	langLinks.forEach((el) => {
		el.addEventListener('click', (e) => {
			e.preventDefault();
			const lang = el.getAttribute('data-lang');
			if (!lang) return;

			try {
				localStorage.setItem('language', lang);
			} catch {}

			if (window.bitdesalI18n?.setLanguage) window.bitdesalI18n.setLanguage(lang);
			else {
				document.documentElement.lang = lang;
				applyLangDropdown(lang);
			}
			closeLangMenus();
		});
	});

	window.addEventListener('bitdesal:language', (e) => {
		const lang = (e as CustomEvent<{ lang?: string }>).detail?.lang;
		if (lang) applyLangDropdown(lang);
	});

	applyLangDropdown(window.bitdesalI18n?.getLanguage?.() || document.documentElement.lang || 'en');
</script>
