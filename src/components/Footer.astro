---
import { CONTACT_EMAIL } from '../data/siteConstants';
import { footerCompanyLinks, sitePath } from '../data/siteNav';
import { legalPath } from '../i18n/localizedRoutes';
import { useI18n } from '../i18n/useI18n';

const year = new Date().getFullYear();
const { lang, t } = useI18n(Astro);
const noticeHref = legalPath('notice', lang);
const privacyHref = legalPath('privacy', lang);
---

<footer class="bg-[#1a1a1a] text-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<div>
				<h3 class="mb-4">Bitdesal</h3>
				<p class="text-white/70 text-sm">{t('footer.tagline')}</p>
				<p class="text-white/60 text-sm mt-3">{t('footer.location')}</p>
			</div>

			<div>
				<h4 class="mb-4">{t('footer.companyTitle')}</h4>
				<ul class="space-y-2 text-sm text-white/70">
					{
						footerCompanyLinks.map((link) => (
							<li>
								<a href={sitePath(link.href, lang)} class="hover:text-white transition-colors">
									{t(link.labelKey, link.fallback)}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h4 class="mb-4">{t('footer.contactTitle')}</h4>
				<ul class="space-y-2 text-sm text-white/70">
					<li>
						<a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-white transition-colors">
							{CONTACT_EMAIL}
						</a>
					</li>
					<li>
						<a
							href="https://www.linkedin.com/company/112619745"
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-white transition-colors"
						>
							{t('footer.linkedin')}
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-8 pt-8 border-t border-white/10 text-center text-sm text-white/70">
			<p>
				&copy; {year} Bitdesal. {t('footer.rights')}
			</p>
			<p class="mt-3 text-xs text-white/50">
				<a href={noticeHref} class="hover:text-white/80 transition-colors">{t('footer.legalNotice')}</a>
				<span aria-hidden="true"> · </span>
				<a href={privacyHref} class="hover:text-white/80 transition-colors">{t('footer.privacy')}</a>
			</p>
		</div>
	</div>
</footer>
