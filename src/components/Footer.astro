---
const year = new Date().getFullYear();
---

<footer class="bg-[#1a1a1a] text-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<div>
				<h3 class="mb-4">Bitdesal</h3>
				<p class="text-white/70 text-sm">
					<span data-i18n-key="footer.tagline">Android Development, AI and High-Level Consulting</span>
				</p>
			</div>

			<div>
				<h4 class="mb-4" data-i18n-key="footer.companyTitle">Company</h4>
				<ul class="space-y-2 text-sm text-white/70">
					<li>
						<a href="/about" class="hover:text-white transition-colors" data-i18n-key="footer.aboutUs"
							>About us</a
						>
					</li>
					<li>
						<a
							href="/methodology"
							class="hover:text-white transition-colors"
							data-i18n-key="footer.methodology"
							>Methodology</a
						>
					</li>
					<li>
						<a href="/projects" class="hover:text-white transition-colors" data-i18n-key="footer.projects"
							>Projects</a
						>
					</li>
					<li>
						<a href="/blog" class="hover:text-white transition-colors" data-i18n-key="footer.blog">Blog</a>
					</li>
				</ul>
			</div>

			<div>
				<h4 class="mb-4" data-i18n-key="footer.contactTitle">Contact</h4>
				<ul class="space-y-2 text-sm text-white/70">
					<li>
						<a href="/contact" class="hover:text-white transition-colors" data-i18n-key="footer.contact"
							>Contact</a
						>
					</li>
					<li>
						<a
							href="https://www.linkedin.com/company/112619745"
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-white transition-colors"
							data-i18n-key="footer.linkedin"
						>
							LinkedIn
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-8 pt-8 border-t border-white/10 text-center text-sm text-white/70">
			<p>
				&copy; {year} Bitdesal.
				<span data-i18n-key="footer.rights">All rights reserved.</span>
			</p>
		</div>
	</div>
</footer>

