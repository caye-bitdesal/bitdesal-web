---
import { useI18n } from '../i18n/useI18n';
import { buildFaqPageJsonLd } from '../data/siteJsonLd';
import { SITE_ORIGIN } from '../data/siteConstants';

interface FaqItem {
	qKey: string;
	aKey: string;
}

interface Props {
	titleKey: string;
	items: FaqItem[];
}

const { titleKey, items } = Astro.props;
const { t } = useI18n(Astro);

const faqItems = items.map((item) => ({
	question: t(item.qKey),
	answer: t(item.aKey),
}));

const canonicalPath =
	Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
		? Astro.url.pathname
		: `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, SITE_ORIGIN).href;
const faqJsonLd = buildFaqPageJsonLd(canonical, faqItems);
---

<section class="py-16 md:py-24 bg-white">
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl md:text-4xl mb-10 text-center">{t(titleKey)}</h2>
		<div class="space-y-3">
			{
				items.map((item) => (
					<details class="group rounded-xl border border-border bg-secondary/40 open:bg-white open:shadow-sm">
						<summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4">
							<h3 class="text-base font-medium m-0 text-left">{t(item.qKey)}</h3>
							<span class="text-primary shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">
								+
							</span>
						</summary>
						<div class="px-5 pb-4 text-foreground/75 leading-relaxed">{t(item.aKey)}</div>
					</details>
				))
			}
		</div>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
