---
import TeamEducationSection from './TeamEducationSection.astro';
import TeamJourneySection from './TeamJourneySection.astro';
import TeamLanguagesSection from './TeamLanguagesSection.astro';
import TeamSkillsSection from './TeamSkillsSection.astro';
import type { TeamExtendedSection } from '../data/teamMembers';

interface Props {
	memberId: string;
	sections: TeamExtendedSection[];
	hidden?: boolean;
}

const { memberId, sections, hidden = false } = Astro.props;
---

<div data-member-extended={memberId} hidden={hidden}>
	{sections.includes('journey') && <TeamJourneySection memberId={memberId} />}
	{sections.includes('education') && <TeamEducationSection memberId={memberId} />}
	{sections.includes('skills') && <TeamSkillsSection />}
	{sections.includes('languages') && <TeamLanguagesSection memberId={memberId} />}
</div>
