---
import { journeyTranslationPrefix, teamJourneyByMember, type JourneyIcon } from '../data/teamJourneyTimelines';
import { useI18n } from '../i18n/useI18n';

interface Props {
	memberId: string;
}

const { memberId } = Astro.props;
const { t } = useI18n(Astro);

const entries = teamJourneyByMember[memberId] ?? [];
const prefix = journeyTranslationPrefix(memberId);

const roleIcons: Record<JourneyIcon, string> = {
	briefcase: '<path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M4 12h16"/>',
	phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
	code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
	web: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
};

const titleKey = `${prefix}.title`;
---

<section class="py-16 md:py-24 bg-white">
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl md:text-4xl mb-12">{t(titleKey)}</h2>
		<ol class="relative">
			{
				entries.map((entry) => (
					<li class="group relative pl-14 pb-12 last:pb-0">
						<span class="absolute left-[15px] top-4 bottom-0 w-0.5 bg-primary/35 group-last:hidden" aria-hidden="true" />
						<span class="absolute left-0 top-0 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white ring-4 ring-secondary" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" set:html={roleIcons[entry.icon]} />
						</span>
						<div class="relative rounded-lg p-4 -mx-2">
							<h3 class="text-xl mb-1">{t(`${prefix}.${entry.id}.role`)}</h3>
							{
								(() => {
									const company = t(`${prefix}.${entry.id}.company`, '');
									const location = t(`${prefix}.${entry.id}.location`, '');
									const companyLine = [company, location].filter(Boolean).join(' · ');
									return companyLine ? <p class="text-foreground/70 mb-1">{companyLine}</p> : null;
								})()
							}
							{
								t(`${prefix}.${entry.id}.dates`, '') && (
									<p class="text-sm text-primary font-medium mb-3">{t(`${prefix}.${entry.id}.dates`)}</p>
								)
							}
							{
								entry.itemCount === 0 ? (
									<p class="text-foreground/70 leading-relaxed">{t(`${prefix}.${entry.id}.summary`)}</p>
								) : (
									<ul class="list-disc list-outside ml-4 space-y-1.5 text-foreground/70">
										{Array.from({ length: entry.itemCount }, (_, i) => (
											<li>{t(`${prefix}.${entry.id}.item${i + 1}`)}</li>
										))}
									</ul>
								)
							}
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
