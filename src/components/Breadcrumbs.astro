---
import type { BreadcrumbItem } from '../data/siteJsonLd';

interface Props {
	items: BreadcrumbItem[];
}

const { items } = Astro.props;
if (items.length < 2) return null;

const lastIndex = items.length - 1;
---

<nav class="border-b border-border/60 bg-secondary/30" aria-label="Breadcrumb">
	<ol class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center gap-1 text-xs text-foreground/65">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-1">
					{index > 0 && <span aria-hidden="true">›</span>}
					{item.href && index < lastIndex ? (
						<a href={item.href} class="hover:text-primary transition-colors">
							{item.name}
						</a>
					) : (
						<span class:list={[index === lastIndex && 'text-foreground/85']} aria-current={index === lastIndex ? 'page' : undefined}>
							{item.name}
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
