---
import CtaSection from './CtaSection.astro';
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../data/siteNav';
import { currencyLocale } from '../i18n/formatCurrency';
import { useI18n } from '../i18n/useI18n';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { lang, t } = useI18n(Astro);
const allPosts = await getCollection('blog');
const localized = lang === 'es' ? post : (allPosts.find((item) => item.id === `${lang}/${post.id}`) ?? post);
const { Content } = await render(localized);

const dateLabel = post.data.pubDate.toLocaleDateString(currencyLocale(lang), {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<Layout seo="blog" title={`${localized.data.title} · Bitdesal`} description={localized.data.description}>
	<article class="py-16 md:py-24 bg-white">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<p class="mb-6">
				<a href={sitePath('/blog', lang)} class="text-sm text-primary hover:underline">{t('blog.back')}</a>
			</p>
			<p class="text-sm text-foreground/60 mb-2">
				{dateLabel}
				<span aria-hidden="true"> · </span>
				<span>{post.data.audience === 'business' ? t('blog.filters.business') : t('blog.filters.technical')}</span>
			</p>
			<h1 class="text-3xl md:text-4xl mb-8">{localized.data.title}</h1>
			<div class="prose prose-neutral max-w-none text-foreground/85">
				<Content />
			</div>
		</div>
	</article>
	<CtaSection />
</Layout>
