---
import BlogEndMatter from './BlogEndMatter.astro';
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../data/siteNav';
import { DEFAULT_OG_IMAGE, SITE_ORIGIN } from '../data/siteConstants';
import { getTeamMember } from '../data/teamMembers';
import { buildFaqPageJsonLd } from '../data/siteJsonLd';
import {
	blogLocales,
	buildBlogPosting,
	extractH2,
	readPostMarkdown,
	readingMinutes,
	relatedPosts,
	wordCount,
	type BlogAuthorId,
} from '../data/blogPost';
import { currencyLocale } from '../i18n/formatCurrency';
import { useI18n } from '../i18n/useI18n';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import '../styles/blog-feature.css';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { lang, t } = useI18n(Astro);
const allPosts = await getCollection('blog');
const localized = lang === 'es' ? post : (allPosts.find((item) => item.id === `${lang}/${post.id}`) ?? post);
const { Content } = await render(localized);
const raw = readPostMarkdown(localized.id);
const minutes = readingMinutes(raw);
const toc = wordCount(raw) > 1000 ? extractH2(raw) : [];
const authorId = (localized.data.author ?? 'caye') as BlogAuthorId;
const author = getTeamMember(authorId);
const highlight = localized.data.titleHighlight ?? '';
const titleLead = highlight
	? localized.data.title.replace(new RegExp(`:?\\s*${escapeRegExp(highlight)}\\s*$`), '').replace(/:\s*$/, '')
	: localized.data.title;

function escapeRegExp(value: string) {
	return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

const heroImage = localized.data.heroImage ?? localized.data.ogImage;
const ogImage = localized.data.ogImage ?? heroImage ?? undefined;

const dateLabel = localized.data.pubDate.toLocaleDateString(currencyLocale(lang), {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const updatedLabel = localized.data.updatedDate
	? localized.data.updatedDate.toLocaleDateString(currencyLocale(lang), {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	: '';

const audienceLabel =
	localized.data.audience === 'business' ? t('blog.filters.business') : t('blog.filters.technical');

const shareLabels = {
	es: { share: 'Compartir artículo', copied: 'Enlace copiado' },
	en: { share: 'Share article', copied: 'Link copied' },
	fi: { share: 'Jaa artikkeli', copied: 'Linkki kopioitu' },
} as const;
const subtitle = localized.data.subtitle;
const shareCopy = shareLabels[lang];

const articlePath = sitePath(`/blog/${post.id}`, lang);
const articleUrl = new URL(articlePath, SITE_ORIGIN).href;
const ids = allPosts.map((item) => item.id);
const image = ogImage ?? DEFAULT_OG_IMAGE;
const blogPosting = buildBlogPosting({
	url: articleUrl,
	title: localized.data.title,
	description: localized.data.description,
	published: localized.data.pubDate,
	modified: localized.data.updatedDate,
	author: authorId,
	image,
	lang,
});
const faq = localized.data.faq ?? [];
const extraJsonLd = faq.length
	? [blogPosting, buildFaqPageJsonLd(articleUrl, faq.map((item) => ({ question: item.q, answer: item.a })))]
	: [blogPosting];
const related = relatedPosts(post, allPosts).map((item) => {
	const translated = lang === 'es' ? item : (allPosts.find((entry) => entry.id === `${lang}/${item.id}`) ?? item);
	const href =
		lang !== 'es' && !ids.includes(`${lang}/${item.id}`) ? `/blog/${item.id}/` : sitePath(`/blog/${item.id}`, lang);
	return { id: item.id, title: translated.data.title, description: translated.data.description, href };
});
const ctaLabels = {
	es: { business: 'Ver la consultoría de IA para empresas', technical: 'Ver el desarrollo de apps Android' },
	en: { business: 'See AI consulting for companies', technical: 'See Android app development' },
	fi: { business: 'Katso tekoälykonsultointi yrityksille', technical: 'Katso Android-sovelluskehitys' },
} as const;
---

<Layout
	seo="blog"
	title={`${localized.data.title} · Bitdesal`}
	description={localized.data.description}
	breadcrumbLabel={localized.data.title}
	ogImage={image}
	alternates={blogLocales(post.id, ids)}
	jsonLd={extraJsonLd}
>
	<article class="bf-article bg-white">
		<div class="bf-main">
			<header class="bf-header">
				<p class="bf-back">
					<a href={sitePath('/blog', lang)} class="text-sm text-primary hover:underline">{t('blog.back')}</a>
				</p>

				<h1 class="bf-title">
					{highlight ? (
						<>
							<span class="bf-title-lead">{titleLead}:</span>{' '}
							<span class="bf-title-accent">{highlight}</span>
						</>
					) : (
						localized.data.title
					)}
				</h1>

				{subtitle && <p class="bf-subtitle">{subtitle}</p>}

				<div class="bf-meta">
					{
						author && (
							<a href={sitePath(`/${authorId}`, lang)} class="bf-author">
								<img src={author.portrait} alt="" width="36" height="36" />
								<span>{t('blog.by')} {author.portraitAlt}</span>
							</a>
						)
					}
					<time datetime={localized.data.pubDate.toISOString().slice(0, 10)}>{dateLabel}</time>
					{
						localized.data.updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								<span>
									{t('blog.updated')}{' '}
									<time datetime={localized.data.updatedDate.toISOString().slice(0, 10)}>{updatedLabel}</time>
								</span>
							</>
						)
					}
					<span aria-hidden="true">·</span>
					<span>{minutes} {t('blog.reading')}</span>
					<span aria-hidden="true">·</span>
					<span>{audienceLabel}</span>
					<button type="button" class="bf-share" data-share data-share-url={articleUrl} data-share-done={shareCopy.copied}>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v14"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						<span data-share-label>{shareCopy.share}</span>
					</button>
				</div>

				{
					heroImage && (
						<div class="bf-hero">
							<img
								src={heroImage}
								alt=""
								width="1600"
								height="640"
								loading="eager"
								decoding="async"
								fetchpriority="high"
							/>
						</div>
					)
				}
			</header>

			{
				toc.length > 0 && (
					<nav class="bf-main mb-8" aria-label={t('blog.related')}>
						<p class="font-medium mb-3">Índice</p>
						<ol class="list-decimal pl-5 space-y-2">
							{toc.map((item) => (
								<li>
									<a href={`#${item.id}`} class="text-primary hover:underline">{item.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="bf-prose">
				<Content />
				<BlogEndMatter
					lang={lang}
					authorId={authorId}
					audience={post.data.audience}
					related={related}
					labels={{ related: t('blog.related'), ...ctaLabels[lang] }}
				/>
			</div>
		</div>
	</article>
</Layout>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-share]');
	const label = document.querySelector<HTMLElement>('[data-share-label]');
	if (button && label) {
		const url = button.dataset.shareUrl ?? window.location.href;
		const done = button.dataset.shareDone ?? 'OK';
		button.addEventListener('click', async () => {
			try {
				if (navigator.share) {
					await navigator.share({ url, title: document.title });
					return;
				}
				await navigator.clipboard.writeText(url);
				const prev = label.textContent;
				label.textContent = done;
				window.setTimeout(() => {
					label.textContent = prev;
				}, 2000);
			} catch {
				/* user cancelled share */
			}
		});
	}
</script>