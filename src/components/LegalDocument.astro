---
import type { LegalDoc } from '../data/legalContent';

interface Props {
	doc: LegalDoc;
}

const { doc } = Astro.props;
---

<section class="py-16 md:py-24 bg-background">
	<article class="max-w-[70ch] mx-auto px-4 sm:px-6 lg:px-8">
		<h1 class="text-3xl md:text-4xl mb-3">{doc.title}</h1>
		<p class="text-sm text-foreground/60 mb-8">
			{doc.updatedLabel}: {doc.updated}
		</p>
		{
			doc.disclaimer && (
				<p class="text-sm italic text-foreground/70 mb-8">{doc.disclaimer}</p>
			)
		}
		{
			doc.intro && (
				<p class="text-foreground/85 leading-relaxed mb-8">{doc.intro}</p>
			)
		}
		{
			doc.sections.map((section) => (
				<section class="mb-10">
					<h2 class="text-xl md:text-2xl mb-4">{section.heading}</h2>
					{section.blocks.map((block) => {
						if (block.type === 'comment') {
							return <Fragment set:html={`<!-- ${block.text} -->`} />;
						}
						if (block.type === 'p') {
							return (
								<p
									class="text-foreground/85 leading-relaxed mb-4 [&_a]:text-primary [&_a]:underline"
									set:html={block.html}
								/>
							);
						}
						if (block.type === 'ul') {
							return (
								<ul class="list-disc pl-5 space-y-2 text-foreground/85 leading-relaxed mb-4">
									{block.items.map((item) => (
										<li set:html={item} />
									))}
								</ul>
							);
						}
						return (
							<div class="overflow-x-auto mb-4 -mx-4 px-4 sm:mx-0 sm:px-0">
								<table class="w-full text-sm text-left border-collapse min-w-[36ch]">
									<thead>
										<tr>
											{block.headers.map((header) => (
												<th class="border border-border bg-muted px-3 py-2 font-medium">{header}</th>
											))}
										</tr>
									</thead>
									<tbody>
										{block.rows.map((row) => (
											<tr>
												{row.map((cell) => (
													<td class="border border-border px-3 py-2 align-top text-foreground/85">{cell}</td>
												))}
											</tr>
										))}
									</tbody>
								</table>
							</div>
						);
					})}
				</section>
			))
		}
	</article>
</section>
