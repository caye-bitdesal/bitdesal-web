---
import '../styles/index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { CONTACT_EMAIL, DEFAULT_OG_IMAGE, SITE_ORIGIN } from '../data/siteConstants';
import { getPageSeo, type PageSeoId } from '../i18n/seo';
import { useI18n } from '../i18n/useI18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { supportedLanguages, type Language } from '../i18n/translations';

interface Props {
	seo?: PageSeoId;
	title?: string;
	description?: string;
	ogImage?: string;
}

const { seo = 'home', title: titleOverride, description: descOverride, ogImage = DEFAULT_OG_IMAGE } = Astro.props;
const { lang, t } = useI18n(Astro);
const themeLabelLight = t('theme.switchToLight', 'Modo claro');
const themeLabelDark = t('theme.switchToDark', 'Modo oscuro');
const seoMeta = getPageSeo(seo, lang);
const title = titleOverride ?? seoMeta.title;
const description = descOverride ?? seoMeta.description;

const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, SITE_ORIGIN).href;

const pathWithoutLocale =
	canonicalPath.replace(/^\/(en|fi)(?=\/|$)/, '').replace(/^\//, '') || '';

function hreflangPath(locale: Language): string {
	const relative = getRelativeLocaleUrl(locale, pathWithoutLocale);
	return new URL(relative, SITE_ORIGIN).href;
}

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			name: 'Bitdesal',
			url: SITE_ORIGIN,
			email: CONTACT_EMAIL,
			areaServed: 'ES',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Elche',
				addressRegion: 'Comunidad Valenciana',
				addressCountry: 'ES',
			},
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Servicios Bitdesal',
				itemListElement: [
					{
						'@type': 'Offer',
						itemOffered: {
							'@type': 'Service',
							name: 'Consultoría de IA para empresas',
							url: `${SITE_ORIGIN}/consultoria-ia`,
						},
					},
					{
						'@type': 'Offer',
						itemOffered: {
							'@type': 'Service',
							name: 'Desarrollo y consultoría de software',
							url: `${SITE_ORIGIN}/consultoria-software`,
						},
					},
				],
			},
		},
		{
			'@type': 'Person',
			name: 'Caye Ruiz',
			jobTitle: 'Fundador de Bitdesal',
			email: CONTACT_EMAIL,
			url: `${SITE_ORIGIN}/nosotros`,
			worksFor: { '@type': 'Organization', name: 'Bitdesal' },
		},
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<script is:inline>
			(function () {
				try {
					var key = 'bitdesal-theme';
					var stored = localStorage.getItem(key);
					var dark =
						stored === 'dark' ||
						(stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
					if (dark) document.documentElement.classList.add('dark');
				} catch (_) {}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{
			supportedLanguages.map((locale) => (
				<link rel="alternate" hreflang={locale} href={hreflangPath(locale)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={hreflangPath('es')} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(ogImage, SITE_ORIGIN).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, SITE_ORIGIN).href} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<Analytics />
	</head>
	<body class="min-h-screen flex flex-col overflow-x-hidden">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<script is:inline define:vars={{ themeLabelLight, themeLabelDark }}>
			(function () {
				var KEY = 'bitdesal-theme';
				var labels = { light: themeLabelLight, dark: themeLabelDark };

				function apply(theme) {
					document.documentElement.classList.toggle('dark', theme === 'dark');
					document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
						btn.setAttribute('aria-label', theme === 'dark' ? labels.light : labels.dark);
						var sun = btn.querySelector('.theme-icon-sun');
						var moon = btn.querySelector('.theme-icon-moon');
						if (sun) sun.classList.toggle('hidden', theme !== 'dark');
						if (moon) moon.classList.toggle('hidden', theme === 'dark');
					});
				}

				function preferred() {
					try {
						var stored = localStorage.getItem(KEY);
						if (stored === 'light' || stored === 'dark') return stored;
					} catch (_) {}
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}

				apply(document.documentElement.classList.contains('dark') ? 'dark' : preferred());

				document.addEventListener('click', function (e) {
					var btn = e.target.closest('[data-theme-toggle]');
					if (!btn) return;
					var next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
					try {
						localStorage.setItem(KEY, next);
					} catch (_) {}
					apply(next);
				});
			})();
		</script>
	</body>
</html>
